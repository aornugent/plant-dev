Measures how wrong dydt_in is at an introduction. Apply to plant develop
141dc8df, rebuild -O2, then run the same script twice:

  Rscript k1.R                                   # develop as-is
  PLANT_K1_FIX=1 PLANT_K1_PROBE=1 Rscript k1.R   # rates recomputed, delta logged

where k1.R runs one production TF24 SCM and reports steps and offspring. The
probe writes one line per introduction to stderr:

  K1 <time> <ode_size> <max|d| pre-existing> <max|d| newborn> <max|d| env> <max rel pre-existing>

--- a/inst/include/plant/patch.h
+++ b/inst/include/plant/patch.h
@@ introduce_new_nodes, after compute_environment(false)
+  static const bool k1_fix   = std::getenv("PLANT_K1_FIX")   != nullptr;
+  static const bool k1_probe = std::getenv("PLANT_K1_PROBE") != nullptr;
+  if (k1_fix || k1_probe) {
+    const size_t n_ode = ode_size();
+    const size_t n_env = environment.ode_size();
+    const size_t n_new = species_index.empty() ? 0 : node_type::ode_size();
+    std::vector<double> before(n_ode, 0.0);
+    if (k1_probe) ode_rates(before.begin());
+    environment_ptr = &environment;
+    compute_rates();
+    if (k1_probe) {
+      std::vector<double> after(n_ode, 0.0);
+      ode_rates(after.begin());
+      const size_t cohort_end = n_ode - n_env;
+      const size_t born_begin = cohort_end > n_new ? cohort_end - n_new : 0;
+      double d_old = 0.0, d_new = 0.0, d_env = 0.0, r_old = 0.0;
+      for (size_t i = 0; i < n_ode; ++i) {
+        const double d = std::abs(after[i] - before[i]);
+        const double scale = std::abs(after[i]) > 1e-300 ? std::abs(after[i]) : 1.0;
+        if (i >= cohort_end)      d_env = std::max(d_env, d);
+        else if (i >= born_begin) d_new = std::max(d_new, d);
+        else { d_old = std::max(d_old, d); r_old = std::max(r_old, d / scale); }
+      }
+      std::fprintf(stderr, "K1 %.8e %zu %.6e %.6e %.6e %.6e\n",
+                   t, n_ode, d_old, d_new, d_env, r_old);
+    }
+  }

Also needs <cstdlib>, <cstdio> and <cmath>.

Result on develop 141dc8df / odelia 854a8e18, -O2, 141 introductions:

  pre-existing cohorts, abs   median 6.66e-09   max 5.884
  newborn's own slots,  abs   median 2.44e-09   max 0.994
  environment (soil),   abs   median 8.31e-06   max 3.10e-03
  pre-existing cohorts, rel   median 1.12e-08   max 1.203e+02

  above 1% relative: 59/141   above 10%: 56   above 100%: 51

