+  // Q and q at one point, sharing the u^eta they are both written in terms of.
+  // q is the negative z-derivative of Q, so a caller building an interpolant that
+  // carries a slope at each knot gets the slope out of the sweep that gives it
+  // the value.
+  //
+  // Written over u^(eta-1)/H rather than u^eta/z: the two are equal for z > 0,
+  // but the z form is 0/0 at the ground and the field's lowest knot sits there.
+  void Q_and_q(double z_over_height, double height_inverse, double& Q_out,
+               double& q_out) const {
+    if (z_over_height > 1.0) {
+      Q_out = 0.0;
+      q_out = 0.0;
+      return;
+    }
+    const double u_eta = pow_eta_(z_over_height, eta_);
+    const double tmp = 1.0 - u_eta;
+    Q_out = tmp * tmp;
+    const double u_eta_over_u =
+        z_over_height > 0.0 ? u_eta / z_over_height : u_eta_over_u_at_0_;
+    q_out = 2.0 * eta_ * tmp * u_eta_over_u * height_inverse;
+  }
+
