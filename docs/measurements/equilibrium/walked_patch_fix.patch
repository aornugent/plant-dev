index be527f7d..397fa242 100644
--- a/tests/testthat/test-scm.R
+++ b/tests/testthat/test-scm.R
@@ -581,6 +581,28 @@ test_that("The sweep through a split run is the derivative of its map", {
                tolerance = 1e-6)
 })
 
+test_that("A sweep after a walk of several invaders gives each its own gradient", {
+  ## Invaders do not interact, so one sweep of their summed census gives each
+  ## invader's columns the gradient it has when walked alone.
+  p0 <- scm_base_parameters("TF24", "TF24_Env")
+  p0$max_patch_lifetime <- 1
+  p <- add_strategies(p0, trait_matrix(0.1978791, "lma"))
+  scm <- run_scm(p, NULL, Control(node_density_in_birth_date = TRUE),
+                 record_trajectory = TRUE)
+  invaders <- add_strategies(p0, trait_matrix(0.1978791 * c(0.9, 1.1), "lma"),
+                             birth_rate = c(1, 1))
+  scm$run_mutant(invaders)
+  both <- census_trait_gradient_tf24(scm, "offspring_production")$gradient[[1]]
+  alone <- unlist(lapply(1:2, function(i) {
+    q <- invaders
+    q$strategies <- q$strategies[i]
+    q$node_schedule_times <- q$node_schedule_times[i]
+    scm$run_mutant(q)
+    census_trait_gradient_tf24(scm, "offspring_production")$gradient[[1]]
+  }))
+  expect_equal(both, alone, tolerance = 1e-12)
+})
+
