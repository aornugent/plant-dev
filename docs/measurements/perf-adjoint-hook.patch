 }
+
+// The adjoint of the state each introduction reached, one row per introduction in
+// recorded order, beside the trait gradient the same sweep accumulated.
+// [[Rcpp::export]]
+Rcpp::List
+census_introduction_adjoints_tf24(plant::RcppR6::RcppR6<plant::SCM<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_,
+                                  std::string metric) {
+  std::vector<double> gradient;
+  const std::vector<std::vector<double>> rows =
+      obj_->census_introduction_adjoints(metric, gradient);
+  return Rcpp::List::create(Rcpp::_["introductions"] = Rcpp::wrap(rows),
+                            Rcpp::_["gradient"] = Rcpp::wrap(gradient));
+}
+
+// Two running totals a sweep adds to: the leaf operating points it placed from the
+// recording, and the inflow-boundary evaluations it recorded.
+// [[Rcpp::export]]
+Rcpp::NumericVector
+census_sweep_counters_tf24(plant::RcppR6::RcppR6<plant::SCM<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_) {
+  double placed = 0.0;
+  for (size_t i = 0; i < obj_->r_patch().size(); ++i) {
+    placed += static_cast<double>(
+        obj_->r_patch().at_species(i).strategy_ptr()->leaf_placements());
+  }
+  return Rcpp::NumericVector::create(
+      Rcpp::_["placements"] = placed,
+      Rcpp::_["boundary_evaluations"] =
+          static_cast<double>(obj_->boundary_condition_evaluations()));
+}
+
+// What a kept recording holds: its rows, the state entries over them, the operating
+// points kept for its rate evaluations, the field entries kept beside them, and the
+// heap blocks all of that sits in. `row_bytes` is one row's own footprint.
+// [[Rcpp::export]]
+Rcpp::NumericVector
+census_recording_size_tf24(plant::RcppR6::RcppR6<plant::SCM<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_) {
+  using patch_type =
+      plant::Patch<plant::TF24_Strategy<double>, plant::TF24_Environment<double>>;
+  if (!obj_->record_trajectory) {
+    plant::util::stop("census_recording_size: this run kept no recording");
+  }
+  const auto rec = obj_->store_trajectory();
+  double states = 0.0, points = 0.0, field = 0.0, insertions = 0.0, blocks = 0.0;
+  for (const auto& row : rec) {
+    states += static_cast<double>(row.state.size());
+    blocks += row.state.empty() ? 0.0 : 1.0;
+    insertions += row.insertion ? 1.0 : 0.0;
+    for (const auto& stage : row.solved) {
+      blocks += stage.strategies.empty() ? 0.0 : 1.0;
+      for (const auto& species : stage.strategies) {
+        points += static_cast<double>(species.size());
+        blocks += species.empty() ? 0.0 : 1.0;
+      }
+      field += static_cast<double>(stage.field.interpolators.size() +
+                                   stage.field.state.size());
+      blocks += (stage.field.interpolators.empty() ? 0.0 : 1.0) +
+                (stage.field.state.empty() ? 0.0 : 1.0);
+    }
+  }
+  return Rcpp::NumericVector::create(
+      Rcpp::_["rows"] = static_cast<double>(rec.size()),
+      Rcpp::_["insertions"] = insertions,
+      Rcpp::_["state_doubles"] = states,
+      Rcpp::_["solved_points"] = points,
+      Rcpp::_["field_doubles"] = field,
+      Rcpp::_["heap_blocks"] = blocks,
+      Rcpp::_["row_bytes"] = static_cast<double>(
+          sizeof(odelia::ode::step_record<patch_type>)),
+      Rcpp::_["point_bytes"] =
+          static_cast<double>(sizeof(plant::leaf_solved_point)));
+}
