 template <typename T, typename E>
+void Species<T,E>::add_spread(with_slope<value_type>& sum, const value_type& c,
+                              const value_type& h, const value_type& h_nb,
+                              const value_type& height, int M) const {
+  if (!util::is_finite(c)) {
+    util::stop("Detected non-finite contribution");
+  }
+  for (int s = 0; s < M; ++s) {
+    const double lambda = (s + 0.5) / M;
+    const double a = 2.0 * (1.0 - lambda) / M;
+    const value_type h_s = h + lambda * (h_nb - h);
+    if (height <= h_s && h_s > 0.0) {
+      const value_type h_inv = 1.0 / h_s;
+      const value_type u = height * h_inv;
+      const std::pair<value_type, value_type> Qq =
+        strategy->canopy_shape.Q_and_q(u, height, h_inv);
+      sum.value += c * a * Qq.first;
+      sum.slope -= c * a * Qq.second;
+    }
+  }
+}
