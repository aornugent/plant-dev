+#include <plant.h>
+#include <plant/probe.h>
+
+// The order probe's tallies of birth-date field builds, one list per scalar
+// type: the double runs and the active sweeps.
+
+namespace {
+Rcpp::List order_tally_list(const plant::probe::order_tally& t) {
+  return Rcpp::List::create(
+    Rcpp::Named("builds") = static_cast<double>(t.builds),
+    Rcpp::Named("ordered") = static_cast<double>(t.ordered),
+    Rcpp::Named("node_disorder") = static_cast<double>(t.node_disorder),
+    Rcpp::Named("boundary_disorder") = static_cast<double>(t.boundary_disorder),
+    Rcpp::Named("fixed") = static_cast<double>(t.fixed),
+    Rcpp::Named("walked") = static_cast<double>(t.walked),
+    Rcpp::Named("most_pairs") = static_cast<double>(t.most_pairs),
+    Rcpp::Named("max_node_inversion") = t.max_node_inversion,
+    Rcpp::Named("max_boundary_inversion") = t.max_boundary_inversion,
+    Rcpp::Named("first_time") = t.first_time,
+    Rcpp::Named("last_time") = t.last_time,
+    Rcpp::Named("node_hist") = std::vector<double>(t.node_hist.begin(), t.node_hist.end()),
+    Rcpp::Named("boundary_hist") = std::vector<double>(t.boundary_hist.begin(), t.boundary_hist.end()));
+}
+}
+
+// [[Rcpp::export]]
+Rcpp::List probe_order_tally() {
+  return Rcpp::List::create(
+    Rcpp::Named("double") = order_tally_list(plant::probe::tally(false)),
+    Rcpp::Named("active") = order_tally_list(plant::probe::tally(true)),
+    Rcpp::Named("mode") = plant::probe::order_mode(),
+    Rcpp::Named("tol") = plant::probe::order_tol(),
+    Rcpp::Named("spread") = plant::probe::spread());
+}
+
+// [[Rcpp::export]]
+void probe_order_reset() {
+  plant::probe::tally(false) = plant::probe::order_tally();
+  plant::probe::tally(true) = plant::probe::order_tally();
+}
