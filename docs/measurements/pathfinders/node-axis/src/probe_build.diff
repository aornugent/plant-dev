+// -*-c++-*-
+#ifndef PLANT_PLANT_PROBE_H_
+#define PLANT_PLANT_PROBE_H_
+
+// Diagnostic switches for the node-rule probes, read once from the environment.
+// Unset, every path is the committed one.
+//   PLANT_PROBE_SPREAD    sub-points per half panel in the birth-date field sum,
+//                         each panel's leaf area spread over its members'
+//                         interpolated heights (0: at the node's height)
+//   PLANT_PROBE_SPREAD_FROM, PLANT_PROBE_SPREAD_UNTIL
+//                         spread only fields built at times in [from, until)
+//   PLANT_PROBE_ORDER     what the birth-date field does when the heights are
+//                         not tallest first: 0 walks every node at every knot;
+//                         1 takes the prefix pass when no height is out of
+//                         order by more than PLANT_PROBE_ORDER_TOL metres;
+//                         2 sorts the crowns by height, then takes the prefix
+//                         pass
+// The tallies count each field build by the path it took, per scalar type.
+
+#include <array>
+#include <cstdlib>
+#include <cstddef>
+#include <limits>
+
+namespace plant {
+namespace probe {
+
+inline int env_int(const char* name, int fallback) {
+  const char* v = std::getenv(name);
+  return (v != nullptr && *v != '\0') ? std::atoi(v) : fallback;
+}
+inline double env_double(const char* name, double fallback) {
+  const char* v = std::getenv(name);
+  return (v != nullptr && *v != '\0') ? std::atof(v) : fallback;
+}
+inline int spread() {
+  static const int m = env_int("PLANT_PROBE_SPREAD", 0);
+  return m;
+}
+// The spread applies to fields built at times in [from, until).
+inline bool spread_at(double time) {
+  static const double from = env_double("PLANT_PROBE_SPREAD_FROM", -1.0);
+  static const double until = env_double("PLANT_PROBE_SPREAD_UNTIL", 1e300);
+  return spread() > 0 && time >= from && time < until;
+}
+inline int order_mode() {
+  static const int m = env_int("PLANT_PROBE_ORDER", 0);
+  return m;
+}
+inline double order_tol() {
+  static const double t = env_double("PLANT_PROBE_ORDER_TOL", 1e-2);
+  return t;
+}
+
+// Field builds on the birth-date path by the path they took. An inversion is
+// how far a node stands above the one born before it; the boundary's is how far
+// the boundary node stands above the newest node, which matters only spread.
+// The histograms bin the build's largest inversion by decade in metres, from
+// below 1e-7 to 1e-1 and above.
+struct order_tally {
+  long builds = 0;
+  long ordered = 0;
+  long node_disorder = 0;
+  long boundary_disorder = 0;
+  long fixed = 0;
+  long walked = 0;
+  long most_pairs = 0;
+  double max_node_inversion = 0.0;
+  double max_boundary_inversion = 0.0;
+  double first_time = std::numeric_limits<double>::infinity();
+  double last_time = -std::numeric_limits<double>::infinity();
+  std::array<long, 8> node_hist{};
+  std::array<long, 8> boundary_hist{};
+};
+inline order_tally& tally(bool active) {
+  static std::array<order_tally, 2> t;
+  return t[active ? 1 : 0];
+}
+inline std::size_t decade_bin(double inversion) {
+  std::size_t k = 0;
+  for (double edge = 1e-7; k < 7 && inversion >= edge; edge *= 10.0) {
+    ++k;
+  }
+  return k;
+}
+
+}
+}
+
+#endif
