+// -*-c++-*-
+#ifndef PLANT_PLANT_PROBE_H_
+#define PLANT_PLANT_PROBE_H_
+
+// Diagnostic switches for the comb probes, read once from the environment.
+// Unset, every path is the committed one. Double runs only.
+//   PLANT_PROBE_KNOTS     the light field's knot count (65)
+//   PLANT_PROBE_SPREAD    sub-points per half panel in the birth-date field sum,
+//                         each panel's leaf area spread over its members'
+//                         interpolated heights (0: at the node's height)
+//   PLANT_PROBE_SPREAD_FROM, PLANT_PROBE_SPREAD_UNTIL
+//                         spread only fields built at times in [from, until)
+//   PLANT_PROBE_SELF      1: a crown reads the field without its twin's panel;
+//                         2: with its twin's panel spread as SPREAD spreads it
+//   PLANT_PROBE_SELF_SUB  sub-points per half panel for SELF=2 (8)
+// The twin of node j is node j of the run that built the field: the node
+// itself for a stand, the stand's node j for an invader replaying its field.
+
+#include <cstdlib>
+#include <cstddef>
+#include <vector>
+
+namespace plant {
+namespace probe {
+
+inline int env_int(const char* name, int fallback) {
+  const char* v = std::getenv(name);
+  return (v != nullptr && *v != '\0') ? std::atoi(v) : fallback;
+}
+inline std::size_t knots() {
+  static const std::size_t n =
+    static_cast<std::size_t>(env_int("PLANT_PROBE_KNOTS", 65));
+  return n;
+}
+inline int spread() {
+  static const int m = env_int("PLANT_PROBE_SPREAD", 0);
+  return m;
+}
+inline double env_double(const char* name, double fallback) {
+  const char* v = std::getenv(name);
+  return (v != nullptr && *v != '\0') ? std::atof(v) : fallback;
+}
+// The spread applies to fields built at times in [from, until).
+inline bool spread_at(double time) {
+  static const double from = env_double("PLANT_PROBE_SPREAD_FROM", -1.0);
+  static const double until = env_double("PLANT_PROBE_SPREAD_UNTIL", 1e300);
+  return spread() > 0 && time >= from && time < until;
+}
+inline int self() {
+  static const int s = env_int("PLANT_PROBE_SELF", 0);
+  return s;
+}
+inline int self_sub() {
+  static const int s = env_int("PLANT_PROBE_SELF_SUB", 8);
+  return s;
+}
+
+// One node's panel as the field holds it: the extinction at height zero from
+// the interval below its birth date and from the one above (establishment
+// share times density times k_I times leaf area, over the patch area), its
+// height, and the heights of the nodes born before and after it.
+struct twin_panel {
+  double c_lo, c_hi, h, h_up, h_dn;
+};
+inline std::vector<twin_panel>& twins() {
+  static std::vector<twin_panel> t;
+  return t;
+}
+// The node whose rates are being computed; -1 outside a node's rates.
+inline long& current() {
+  static long i = -1;
+  return i;
+}
+
+// sum over M sub-points of weight(s) * f(height(s)) for one half panel: heights
+// h + lambda (h_nb - h) at lambda = (s + 1/2) / M, weights 2 (1 - lambda) / M,
+// the node's hat on that interval, so the weights sum to one.
+template <typename F>
+inline void for_each_sub_point(int M, double h, double h_nb, F f) {
+  for (int s = 0; s < M; ++s) {
+    const double lambda = (s + 0.5) / M;
+    f(h + lambda * (h_nb - h), 2.0 * (1.0 - lambda) / M);
+  }
+}
+
+}
+}
+
+#endif
