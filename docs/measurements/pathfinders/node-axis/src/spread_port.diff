+template <typename T, typename E>
+void Species<T,E>::spread_field_splits(const std::vector<value_type>& heights,
+                                       std::vector<competition_split>& out) const {
+  using moments = std::array<value_type, CanopyShape<value_type>::max_moments>;
+  const std::size_t n_moments = strategy->canopy_shape.n_moments();
+  const int M = probe::spread();
+  const std::size_t n = size();
+  // prefix[p] sums the moments of the first p point crowns, tallest first.
+  std::vector<value_type> crown_top;
+  std::vector<moments> prefix(1);
+  crown_top.reserve(n * M);
+  prefix.reserve(n * M + 1);
+  for (std::size_t j = 0; j < n_moments; ++j) {
+    prefix[0][j] = value_type(0.0);
+  }
+  for (std::size_t i = 0; i < n; ++i) {
+    const node_type& end = i + 1 < n ? nodes[i + 1] : new_node;
+    const auto share = nodes[i].interval_shares(
+      end.introduction_time() - nodes[i].introduction_time());
+    const value_type c_upper = share.first * nodes[i].compute_competition(0.0);
+    const value_type c_lower = i + 1 < n
+      ? value_type(share.second * end.compute_competition(0.0))
+      : value_type(0.0);
+    if (!util::is_finite(c_upper) || !util::is_finite(c_lower)) {
+      util::stop("Detected non-finite contribution");
+    }
+    const value_type h0 = nodes[i].height();
+    const value_type h1 = end.height();
+    for (int s = 0; s < M; ++s) {
+      const double lambda = (s + 0.5) / M;
+      const value_type h_s = h0 + lambda * (h1 - h0);
+      const value_type c = c_upper * (2.0 * (1.0 - lambda) / M) +
+                           c_lower * (2.0 * lambda / M);
+      const value_type h_inv = 1.0 / h_s;
+      moments raw, next;
+      strategy->canopy_shape.crown_moments(h_inv, raw);
+      for (std::size_t j = 0; j < n_moments; ++j) {
+        next[j] = prefix.back()[j] + c * raw[j];
+      }
+      crown_top.push_back(h_s);
+      prefix.push_back(next);
+    }
+  }
+  const HeightScan& scan = scan_heights();
+  moments weight, weight_slope;
+  std::size_t reach = crown_top.size();
+  for (std::size_t k = 0; k < heights.size(); ++k) {
+    const value_type& height = heights[k];
+    if (scan.h_max < height) {
+      continue;
+    }
+    while (reach > 0 && crown_top[reach - 1] < height) {
+      --reach;
+    }
+    strategy->canopy_shape.height_weights(height, weight);
+    strategy->canopy_shape.height_weight_slopes(height, weight_slope);
+    competition_split& c = out[k];
+    for (std::size_t j = 0; j < n_moments; ++j) {
+      c.without_boundary.value += weight[j] * prefix[reach][j];
+      c.without_boundary.slope += weight_slope[j] * prefix[reach][j];
+    }
+    c.closes = true;
+  }
+}
+
+template <typename T, typename E>
+with_slope<typename Species<T,E>::value_type>
+Species<T,E>::spread_field(const value_type& height) const {
+  const int M = probe::spread();
+  with_slope<value_type> sum{value_type(0.0), value_type(0.0)};
+  value_type from_previous(0.0);
+  for (size_t j = 0; j < size(); ++j) {
+    const node_type& end = j + 1 < size() ? nodes[j + 1] : new_node;
+    const auto share = nodes[j].interval_shares(
+      end.introduction_time() - nodes[j].introduction_time());
+    const value_type scale = nodes[j].compute_competition(0.0);
+    const value_type h = nodes[j].height();
+    if (j > 0) {
+      add_spread(sum, from_previous * scale, h, nodes[j - 1].height(), height, M);
+    }
+    add_spread(sum, share.first * scale, h, end.height(), height, M);
+    from_previous = share.second;
+  }
+  return sum;
+}
+
+template <typename T, typename E>
+std::vector<probe::twin_panel> Species<T,E>::twin_panels(double area) const {
+  using odelia::util::to_passive;
+  std::vector<probe::twin_panel> ret;
+  ret.reserve(size());
+  value_type from_previous(0.0);
+  for (size_t j = 0; j < size(); ++j) {
+    const node_type& end = j + 1 < size() ? nodes[j + 1] : new_node;
+    const auto share = nodes[j].interval_shares(
+      end.introduction_time() - nodes[j].introduction_time());
+    const double scale = to_passive(nodes[j].compute_competition(0.0)) / area;
+    const double h = to_passive(nodes[j].height());
+    ret.push_back({to_passive(from_previous) * scale, to_passive(share.first) * scale, h,
+                   j > 0 ? to_passive(nodes[j - 1].height()) : h,
+                   to_passive(end.height())});
+    from_previous = share.second;
+  }
+  return ret;
+}
