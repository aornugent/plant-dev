+test_that("an invader introduced at some of the run's introductions keeps each member's fitness, TF24", {
+  # Its members see only the recorded field, so the members it keeps produce what
+  # they produce on the run's whole schedule, and each kept interval takes the
+  # establishment of the intervals it merges.
+  fixture <- tf24_invasion_fixture()
+  ctrl <- Control(node_density_in_birth_date = TRUE)
+  scm <- run_scm(fixture$p, env = fixture$env, ctrl = ctrl)
+  times <- fixture$p$node_schedule_times[[1]]
+  establishment <- function(sp) {
+    state <- matrix(sp$ode_state, ncol = sp$size, dimnames = list(sp$new_node$ode_names))
+    state["interval_establishment", ]
+  }
+
+  scm$run_mutant(fixture$p)
+  full <- scm$patch$species[[1]]
+  keep <- c(1:5, 8, 12, 20)
+  q <- fixture$p
+  q$node_schedule_times <- list(times[keep])
+  scm$run_mutant(q)
+  some <- scm$patch$species[[1]]
+
+  expect_identical(some$node_times, times[keep])
+  expect_identical(some$net_reproduction_ratio_by_node,
+                   full$net_reproduction_ratio_by_node[keep])
+  merged <- vapply(seq_along(keep), function(i) {
+    to <- if (i < length(keep)) keep[i + 1] - 1 else length(times)
+    sum(establishment(full)[keep[i]:to])
+  }, 0)
+  expect_equal(establishment(some), merged, tolerance = 1e-12)
+})
