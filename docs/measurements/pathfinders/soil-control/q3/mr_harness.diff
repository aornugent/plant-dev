+# The chain alone from layers th over [ta, tb], its uptake per layer line(s).
+chain_run <- function(th, ta, tb, line) {
+  f <- function(x, s) {
+    r <- stiff_rates(x, rain_at(s)) - line(s) / dz
+    r[x <= theta_res & !(r > 0)] <- 0
+    r
+  }
+  s <- ta; hs <- tb - ta; k1 <- f(th, s)
+  while (s < tb) {
+    final <- s + hs >= tb
+    hh <- if (final) tb - s else hs
+    k <- list(k1)
+    for (i in 2:6) k[[i]] <- f(combine(th, tab$ACK[i, ], k, hh), s + tab$cCK[i] * hh)
+    y1 <- combine(th, tab$bCK, k, hh)
+    e <- combine(0, tab$bCK - tab$dCK, k, hh)
+    r <- max(abs(e) / (CHAIN_TOL * abs(y1) + 1e-4 * CHAIN_TOL))
+    if (!is.finite(r)) r <- 1e10
+    if (r > 1.1 && hh > 1e-12) { hs <- hh * max(0.2, 0.9 / r^(1 / 5)); next }
+    n$chain_substeps <- n$chain_substeps + 1
+    s <- if (final) tb else s + hh
+    th <- y1
+    k1 <- f(th, s)
+    if (!final) hs <- hh * min(5, max(0.2, 0.9 / max(r, 1e-300)^(1 / 5)))
+  }
+  th
+}
+
+# The chain alone from th at t, at each offset in cs (fractions of h), in cs's order.
+chain_at <- function(th, t, h, line, cs) {
+  out <- vector("list", length(cs))
+  s0 <- 0
+  for (j in order(cs)) {
+    if (cs[j] > s0) {
+      th <- chain_run(th, t + s0 * h, t + cs[j] * h, line)
+      s0 <- cs[j]
+    }
+    out[[j]] <- th
+  }
+  out
+}
+
+# The uptake's share of the soil's budget at a step's start, chain-wide, as soil_diag
+# reads it at the first stage.
+start_share <- function(t, y, u) {
+  th <- y[soil(y)]
+  out <- K_sat * (pmin(pmax(th, 0), theta_s) / theta_s)^q
+  inflow <- c(rain_at(t) * max(0, 1 - (th[1] / theta_s)^b_inf), out[-5])
+  sum(abs(u)) / sum(abs(inflow) + abs(out) + abs(u))
+}
+
+# One multirate attempt from (t, y), whose rates are k1 (MR_SHARE).
+attempt_mr <- function(t, y, k1, h) {
+  blk <- soil(y)
+  u0 <- sv$uptake
+  slope <- if (is.finite(sv$h_prev)) (u0 - sv$uptake_prev) / sv$h_prev else 0 * u0
+  u1p <- pmax(0, u0 + h * slope)
+  thp <- chain_at(y[blk], t, h, function(s) u0 + (u1p - u0) * (s - t) / h, c(tb$c[2:6], 1))
+  k <- list(k1)
+  up <- matrix(0, 6, 5)
+  up[1, ] <- u0
+  for (i in 2:6) {
+    Y <- combine(y, tb$A[i, ], k, h)
+    Y[blk] <- thp[[i - 1]]
+    ki <- rates(Y, t + tb$c[i] * h)
+    if (is.null(ki)) return(NULL)
+    k[[i]] <- ki
+    up[i, ] <- tail(patch$ode_aux, 5)
+  }
+  y1 <- combine(y, tb$b, k, h)
+  y1[blk] <- thp[[6]]
+  if (is.null(rates(y1, t + h))) return(NULL)
+  u1 <- tail(patch$ode_aux, 5)
+  thc <- chain_at(y[blk], t, h, function(s) u0 + (u1 - u0) * (s - t) / h, 1)[[1]]
+  y1[blk] <- thc
+  at_end <- rates(y1, t + h)
+  if (is.null(at_end)) return(NULL)
+  yerr <- combine(0, tb$b - tb$d, k, h)
+  lin <- outer(1 - tb$c, u0) + outer(tb$c, u1)
+  defect <- h * colSums(tb$b * abs(up - lin)) / dz
+  yerr[blk] <- pmax(abs(thc - thp[[6]]), defect)
+  n$mr_attempts <- n$mr_attempts + 1
+  list(y = y1, yerr = yerr, rates = at_end, P = production(y1), K = klass(y1),
+       Pst = NULL, Kst = NULL, uptake = tail(patch$ode_aux, 5),
+       soil_est = c(max(abs(yerr[blk])), NA), diag = NULL)
+}
