+# A table that grows by doubling: add() appends one row, rows() returns those added.
+growing <- function(cols) {
+  g <- new.env()
+  g$m <- matrix(NA_real_, 1024, length(cols), dimnames = list(NULL, cols))
+  g$k <- 0L
+  g$add <- function(v) {
+    g$k <- g$k + 1L
+    if (g$k > nrow(g$m)) g$m <- rbind(g$m, g$m * NA)
+    g$m[g$k, ] <- v
+  }
+  g$rows <- function() as.data.frame(g$m[seq_len(g$k), , drop = FALSE])
+  g
+}
