+# Each layer's budget over an attempt from its stage soil states thst and uptakes ust:
+# infiltration or the drainage from above, its own drainage, and the uptake, each summed
+# over the stages at the pair's solution weights. Returns the uptake's share per layer
+# and chain-wide, over the step and at its start; the uptake's defect against the line
+# between the step's ends, h sum_i b_i (u_i - u_lin(c_i)) / dz; and both soil estimates.
+soil_diag <- function(t, h, thst, ust, u_end, e_emb, e_true) {
+  inflow <- outflow <- up <- matrix(0, 6, 5)
+  for (i in 1:6) {
+    th <- thst[[i]]
+    out <- K_sat * (pmin(pmax(th, 0), theta_s) / theta_s)^q
+    inflow[i, ] <- c(rain_at(t + tb$c[i] * h) * max(0, 1 - (th[1] / theta_s)^b_inf), out[-5])
+    outflow[i, ] <- out
+    up[i, ] <- ust[[i]]
+  }
+  bw <- tb$b
+  num <- colSums(bw * abs(up))
+  den <- colSums(bw * (abs(inflow) + abs(outflow) + abs(up)))
+  num0 <- abs(up[1, ]); den0 <- abs(inflow[1, ]) + abs(outflow[1, ]) + abs(up[1, ])
+  lin <- outer(1 - tb$c, ust[[1]]) + outer(tb$c, u_end)
+  defect <- h * colSums(bw * (up - lin)) / dz
+  list(share = num / den, share_chain = sum(num) / sum(den),
+       share0 = num0 / den0, share0_chain = sum(num0) / sum(den0),
+       defect = defect, e_emb = e_emb, e_true = e_true)
 }
 
