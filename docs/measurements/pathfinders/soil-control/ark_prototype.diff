+# Each component group's weighted ratio on the attempt `a` of size h from t0, under the level
+# its adjust() just used: grp is 1 soil, 2 accumulator, 3 member, 4 storage.
+diag_row <- function(t0, h, a, accepted) {
+  d <- a$diag
+  lev <- abs(ctl$level)
+  blk <- soil(a$y); acc <- length(a$y) - 4:0
+  m <- 9 * ((length(a$y) - 10) %/% 9)
+  r_all <- abs(a$yerr) / lev
+  r_emb <- abs(d$e_emb) / lev[blk]
+  r_true <- abs(d$e_true) / lev[blk]
+  pool <- pool_of(a$y)
+  i <- ctl$index
+  grp <- if (is.na(i)) NA else if (i %in% blk) 1 else if (i %in% acc) 2 else if (i %in% pool) 4 else 3
+  lb <- which.max(r_emb)
+  c(t0, h, accepted, grp, ctl$ratio, max(r_emb), max(r_true),
+    if (m) max(r_all[seq_len(m)]) else 0, if (m) max(r_all[pool]) else 0, max(r_all[acc]),
+    lb, which.max(r_true), d$share[lb], d$share_chain, d$share0_chain, d$share0, d$share,
+    r_emb, r_true, abs(d$defect) / lev[blk], h * lambda_soil(sv$y, t0) / BETA,
+    rain_at(t0), rain_at(t0 + h / 2), rain_at(t0 + h), m / 9)
+}
+# The coupled system from (t0, y0, f0) over h by n Cash-Karp sub-steps, evaluated directly so
+# the run's counters do not move; NULL where an evaluation raises.
+coupled_ref <- function(t0, y0, f0, h, n) {
+  y <- y0; f <- f0; hs <- h / n; s <- t0
+  ev <- function(Y, tt) tryCatch(patch$derivs(Y, tt), `odelia::util::DomainError` = function(e) NULL)
+  for (m in seq_len(n)) {
+    k <- list(f)
+    for (i in 2:6) {
+      k[[i]] <- ev(combine(y, tab$ACK[i, ], k, hs), s + tab$cCK[i] * hs)
+      if (is.null(k[[i]])) return(NULL)
+    }
+    y <- combine(y, tab$bCK, k, hs)
+    s <- if (m == n) t0 + h else s + hs
+    if (m < n) {
+      f <- ev(y, s)
+      if (is.null(f)) return(NULL)
+    }
+  }
+  y
+}
+# The accepted attempt `a` of size h from sv's state at t0 against the coupled reference;
+# afterwards the Patch is put back on the attempt's end, where the run left it.
+ref_row <- function(t0, h, a) {
+  yref <- coupled_ref(t0, sv$y, sv$dydt, h, REF_SUB)
+  patch$derivs(a$y, t0 + h)
+  lev <- abs(ctl$level)
+  blk <- soil(a$y)
+  m <- 9 * ((length(a$y) - 10) %/% 9)
+  pool <- pool_of(a$y)
+  if (is.null(yref)) return(c(t0, h, rep(NA, 19), 0))
+  e <- abs(a$y - yref) / lev
+  c(t0, h, e[blk], abs(a$diag$e_true) / lev[blk], abs(a$diag$e_emb) / lev[blk],
+    if (m) max(abs(a$yerr[seq_len(m)]) / lev[seq_len(m)]) else 0, if (m) max(e[seq_len(m)]) else 0,
+    if (m) max(abs(a$yerr[pool]) / lev[pool]) else 0, if (m) max(e[pool]) else 0, 1)
+}
