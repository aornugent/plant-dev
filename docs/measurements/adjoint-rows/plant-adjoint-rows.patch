+template <typename T, typename E>
+std::vector<double>
+SCM<T, E>::census_row_replay(size_t row, const std::vector<double>& state) {
+  const trajectory rec = store_trajectory();
+  if (row >= rec.size() || rec[row].insertion) {
+    util::stop("census_row_replay: row " + util::to_string(row) +
+               " is not a recorded step");
+  }
+  patch_type& live = solver.get_system_ref();
+  odelia::ode::be_at_step(live, rec, row);
+  util::check_length(state.size(), rec[row].state.size());
+  auto active = live.template rebind_from<double>();
+  active.set_ode_state(state.begin(), rec[row].time);
+  odelia::ode::Solver<decltype(active)> forward(active, make_ode_control(control));
+  forward.set_collect(false);
+  forward.set_state_from_system();
+  forward.advance_recorded(odelia::ode::program_from(
+      rec, row, {forward.time(), std::numeric_limits<double>::quiet_NaN()}));
+  odelia::ode::be_at_step(live, rec, rec.size() - 1);
+  std::vector<double> ret;
+  for (const stand_metric& metric : stand_metrics()) {
+    ret.push_back(metric_value(forward.get_system_ref(), metric));
+  }
+  return ret;
+}
 
