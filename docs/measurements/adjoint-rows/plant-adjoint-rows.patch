+##' The state adjoint of one metric at every recorded row.
+##'
+##' One sweep of the recording, as \code{\link{stand_gradient}} takes, keeping the
+##' adjoint of the state at each row it crosses. Rows align with
+##' \code{scm$store_trajectory()}: at an introduction the row before holds the
+##' narrower state's adjoint and the introduction row the wider one's. Each entry
+##' is per unit of that state entry, as recorded; nothing is divided by density.
+##'
+##' @param scm A run \code{SCM} object for the TF24 model, recorded or not.
+##' @param metric One metric name, as \code{\link{stand_gradient}} takes.
+##' @return A list with \code{time} and \code{introduction}, one per row;
+##'   \code{adjoint}, one named vector per row, each entry named
+##'   \code{"<species>.<node>.<component>"} or \code{"env.<k>"}; and
+##'   \code{gradient}, the same sweep's trait gradient.
+##' @export
+stand_adjoint_rows <- function(scm, metric) {
+  b <- census_backend(scm)
+  if (is.null(b$adjoint_rows)) {
+    stop("Adjoint rows are kept for TF24 only")
+  }
+  b$adjoint_rows(scm, metric)
+}
+
