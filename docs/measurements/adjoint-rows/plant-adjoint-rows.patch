diff --git a/src/census_gradient.cpp b/src/census_gradient.cpp
index 47f93891..32443883 100644
--- a/src/census_gradient.cpp
+++ b/src/census_gradient.cpp
@@ -84,6 +84,83 @@ Rcpp::NumericVector control_of(SCM& scm) {
   return out;
 }
 
+// Each entry of the state recorded at `time`, in the order ode_state writes it:
+// per species its nodes' entries ("1.3.mortality") and top layer's, then the
+// environment's ("env.2"). An insertion row holds the nodes introduced at `time`.
+template <class Patch>
+Rcpp::CharacterVector state_labels(const Patch& patch, double time,
+                                   bool insertion, size_t width) {
+  const typename Patch::introduction added =
+      insertion ? patch.introduced_at(time) : typename Patch::introduction{};
+  std::vector<std::string> ret;
+  size_t species_width = 0;
+  for (size_t i = 0; i < patch.size(); ++i) {
+    const auto& species = patch.at_species(i);
+    const std::string s = std::to_string(i + 1) + ".";
+    const std::vector<std::string> node = species.r_new_node().ode_names();
+    const size_t n = patch.nodes_at(i, time) +
+        (std::find(added.begin(), added.end(), i) != added.end() ? 1 : 0);
+    for (size_t j = 0; j < n; ++j) {
+      for (const std::string& c : node) {
+        ret.push_back(s + std::to_string(j + 1) + "." + c);
+      }
+    }
+    for (size_t c = 0; c < species.top_ode_size(); ++c) {
+      ret.push_back(s + "top." + std::to_string(c + 1));
+    }
+    species_width += species.ode_size();
+  }
+  const size_t n_env = patch.ode_size() - species_width;
+  for (size_t k = 0; k < n_env; ++k) {
+    ret.push_back("env." + std::to_string(k + 1));
+  }
+  if (ret.size() != width) {
+    plant::util::stop("state_labels: the schedule gives " +
+                      std::to_string(ret.size()) + " entries at t=" +
+                      std::to_string(time) + " against " +
+                      std::to_string(width) + " recorded");
+  }
+  return Rcpp::wrap(ret);
+}
+
+// One metric's state adjoint at every recorded row, beside the trait gradient
+// the same sweep accumulated. Rows align with store_trajectory().
+template <class SCM>
+Rcpp::List adjoint_rows_of(SCM& scm, const std::string& metric) {
+  std::vector<odelia::ode::adjoint_rows> kept;
+  const plant::census_gradient g = scm.census_trait_gradient({}, {metric}, &kept);
+  if (g.why.front().happened()) {
+    plant::util::stop("census_adjoint_rows: " + g.why.front().reason);
+  }
+  const auto rec = scm.store_trajectory();
+  const auto& patch = scm.r_patch();
+  Rcpp::NumericVector time(rec.size());
+  Rcpp::LogicalVector introduction(rec.size());
+  Rcpp::List adjoint(rec.size());
+  Rcpp::CharacterVector labels;
+  for (size_t k = 0; k < rec.size(); ++k) {
+    time[k] = rec[k].time;
+    introduction[k] = rec[k].insertion;
+    const size_t width = rec[k].state.size();
+    Rcpp::NumericVector row(width);
+    if (kept[k].rows() > 0) {
+      std::copy(kept[k][0].begin(), kept[k][0].end(), row.begin());
+    }
+    if (k == 0 || rec[k].insertion || rec[k - 1].insertion ||
+        labels.size() != static_cast<R_xlen_t>(width)) {
+      labels = state_labels(patch, rec[k].time, rec[k].insertion, width);
+    }
+    row.names() = labels;
+    adjoint[k] = row;
+  }
+  Rcpp::NumericVector gradient = Rcpp::wrap(g.gradient.front());
+  gradient.names() = Rcpp::wrap(scm.r_patch().trait_adjoint_names());
+  return Rcpp::List::create(Rcpp::_["time"] = time,
+                            Rcpp::_["introduction"] = introduction,
+                            Rcpp::_["adjoint"] = adjoint,
+                            Rcpp::_["gradient"] = gradient);
+}
+
 }  // namespace
 
