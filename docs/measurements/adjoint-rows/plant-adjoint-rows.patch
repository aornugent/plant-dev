+
+// The sum rule's terms for one metric, from that metric's adjoint rows: per
+// recorded row, the rates' trait partials contracted with the row's adjoint; per
+// insertion row, the insertion's trait partials contracted with the wider adjoint;
+// and the census's own reading of the traits. A resident's: an invader's rates
+// read a field this patch does not hold.
+// [[Rcpp::export]]
+Rcpp::List adjoint_rows_sum_rule_terms_tf24(plant::RcppR6::RcppR6<plant::SCM<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_,
+                                            std::string metric) {
+  std::vector<odelia::ode::adjoint_rows> kept;
+  obj_->census_trait_gradient({}, {metric}, &kept);
+  const auto rec = obj_->store_trajectory();
+  patch_type patch = obj_->r_patch();
+  const size_t n_trait = patch.trait_adjoint_size();
+  Rcpp::NumericMatrix rate(static_cast<int>(rec.size()), static_cast<int>(n_trait));
+  Rcpp::NumericMatrix insertion(static_cast<int>(rec.size()),
+                                static_cast<int>(n_trait));
+  odelia::ode::adjoint_tape<double> tape(false);
+  for (size_t k = 0; k < rec.size(); ++k) {
+    if (rec[k].state.empty() || kept[k].rows() == 0) {
+      continue;
+    }
+    const std::vector<double> seed(kept[k][0].begin(), kept[k][0].end());
+    std::vector<double> lambda_state, traits;
+    if (rec[k].insertion) {
+      const double when = rec[k].time;
+      odelia::ode::be_at_step(patch, rec, k - 1);
+      auto insert = [&](auto& sys, typename std::vector<adjoint>::const_iterator x,
+                        std::vector<adjoint>& y) -> void {
+        odelia::ode::apply_insertion(sys, when, x, y);
+      };
+      odelia::ode::adjoint_rows narrowed, rows(1, n_trait);
+      {
+        odelia::ode::active_system<patch_type> widened{patch, tape};
+        odelia::ode::state_and_parameter_adjoints(
+            widened, rec[k - 1].state, kept[k], insert, narrowed, rows);
+      }
+      for (size_t c = 0; c < n_trait; ++c) {
+        insertion(static_cast<int>(k), static_cast<int>(c)) = rows[0][c];
+      }
+      odelia::ode::be_at_step(patch, rec, k - 1);
+      std::vector<double> wide;
+      patch.apply_insertion(when, rec[k - 1].state.begin(), wide);
+    } else {
+      odelia::ode::be_at_step(patch, rec, k);
+    }
+    rhs_adjoint(patch, tape, seed, lambda_state, traits);
+    for (size_t c = 0; c < n_trait; ++c) {
+      rate(static_cast<int>(k), static_cast<int>(c)) = traits[c];
+    }
+  }
+  const auto metrics = obj_->stand_metrics();
+  size_t m = 0;
+  while (m < metrics.size() && metrics[m].name != metric) {
+    ++m;
+  }
+  const plant::census_rows both = obj_->census_state_and_trait_rows();
+  const std::vector<double> direct(both.trait[m].begin(), both.trait[m].end());
+  return Rcpp::List::create(Rcpp::_["rate"] = rate,
+                            Rcpp::_["insertion"] = insertion,
+                            Rcpp::_["direct"] = direct);
+}
