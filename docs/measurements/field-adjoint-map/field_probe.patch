+template <typename T, typename E>
+void Patch<T,E>::set_field_probe(const std::vector<double>& at,
+                                 const std::vector<double>& weight,
+                                 const std::vector<double>& bands, int order,
+                                 bool open, bool drop,
+                                 const std::vector<double>& light,
+                                 const std::vector<double>& soil) {
+  util::check_length(weight.size(), at.size());
+  const size_t n = at.size() * (bands.size() + 1);
+  util::check_length(light.size(), n);
+  util::check_length(soil.size(), n);
+  if (!std::is_sorted(bands.begin(), bands.end())) {
+    util::stop("set_field_probe: the band breaks must ascend");
+  }
+  field_probe.at = at;
+  field_probe.weight = weight;
+  field_probe.bands = bands;
+  field_probe.order = order;
+  field_probe.open = open;
+  field_probe.drop = drop;
+  field_probe.light.assign(light.begin(), light.end());
+  field_probe.soil.assign(soil.begin(), soil.end());
+}
+
+// Engaged wherever a coefficient can move a number: always at an active or
+// tangent scalar, and at double only where some coefficient is nonzero.
+template <typename T, typename E>
+bool Patch<T,E>::field_probe_engaged() const {
+  if (field_probe.light.empty() || species.empty()) {
+    return false;
+  }
+  if constexpr (std::is_same_v<value_type, double>) {
+    for (size_t c = 0; c < field_probe.light.size(); ++c) {
+      if (field_probe.light[c] != 0.0 || field_probe.soil[c] != 0.0) {
+        return true;
+      }
+    }
+    return false;
+  }
+  return true;
+}
+
+template <typename T, typename E>
+std::vector<typename Patch<T,E>::probe_panel>
+Patch<T,E>::field_probe_panels() const {
+  using odelia::util::to_passive;
+  std::vector<probe_panel> ret;
+  const species_type& sp = species[0];
+  const size_t n = sp.size();
+  const double t = environment.time;
+  const auto& s = *sp.strategy_ptr();
+  if constexpr (requires { s.pars.k_I; s.area_leaf(value_type(1.0)); }) {
+    const size_t band = static_cast<size_t>(
+        std::upper_bound(field_probe.bands.begin(), field_probe.bands.end(), t) -
+        field_probe.bands.begin());
+    const ExtrinsicDrivers drivers = sp.extrinsic_drivers();
+    // A node's coordinates in birth date: height, mortality, and the density's
+    // log less the mortality's share, which is the birth rate's.
+    auto birth = [&](const node_type& x) { return x.introduction_time(); };
+    auto mortality = [](const node_type& x) {
+      return to_passive(x.individual.state(MORTALITY_INDEX));
+    };
+    auto leaf_area = [&](double height) {
+      return height > 0 ? to_passive(s.area_leaf(value_type(height))) : 0.0;
+    };
+    if (field_probe.drop) {
+      // Node j is the finer schedule's own, between j - 1 and j + 1 (the
+      // boundary node while it is the newest): its defect is what dropping it
+      // takes from the field, at its state and weight.
+      const std::vector<double> weights = sp.establishment_weights();
+      for (size_t j = 1; j < n && j < field_probe.at.size(); ++j) {
+        if (!std::isfinite(field_probe.at[j])) {
+          continue;
+        }
+        const node_type& mid = sp.node_at(j);
+        const node_type& lo = sp.node_at(j - 1);
+        const bool closed = j + 1 < n;
+        const node_type& hi = closed ? sp.node_at(j + 1) : sp.r_new_node();
+        const double x_lo = birth(lo);
+        const double x_hi = closed ? birth(hi) : t;
+        if (!(x_hi > x_lo)) {
+          continue;
+        }
+        probe_panel q;
+        q.coefficient = j * field_probe.n_bands() + band;
+        q.lo = &lo;
+        q.hi = &hi;
+        q.mid = &mid;
+        q.lambda = (birth(mid) - x_lo) / (x_hi - x_lo);
+        q.weight = -weights[j];
+        q.height = to_passive(mid.height());
+        q.da = to_passive(mid.get_density()) * leaf_area(q.height);
+        q.lo_height = to_passive(lo.height());
+        q.lo_da = to_passive(lo.get_density()) * leaf_area(q.lo_height);
+        q.hi_height = to_passive(hi.height());
+        q.hi_da = to_passive(hi.get_density()) * leaf_area(q.hi_height);
+        ret.push_back(q);
+      }
+      return ret;
+    }
+    for (size_t p = 0; p < n && p < field_probe.at.size(); ++p) {
+      const double m = field_probe.at[p];
+      const bool closed = p + 1 < n;
+      if (!std::isfinite(m) || t <= m || (!closed && !field_probe.open)) {
+        continue;
+      }
+      const node_type& lo = sp.node_at(p);
+      const node_type& hi = closed ? sp.node_at(p + 1) : sp.r_new_node();
+      const double x_lo = birth(lo);
+      const double x_hi = closed ? birth(hi) : t;
+      const double width = x_hi - x_lo;
+      if (!(width > 0)) {
+        continue;
+      }
+      const double lambda = (m - x_lo) / width;
+      const auto share = lo.interval_shares(width);
+      const double I = to_passive(share.first + share.second);
+      const double w = closed && std::isfinite(field_probe.weight[p])
+                           ? field_probe.weight[p] : I / 2;
+      double h = (1 - lambda) * to_passive(lo.height()) + lambda * to_passive(hi.height());
+      double mu = (1 - lambda) * mortality(lo) + lambda * mortality(hi);
+      if (field_probe.order == 2) {
+        // The curvature in birth date from the neighbours either side,
+        // averaged where both exist: f[a, b, c] (m - x_lo) (m - x_hi).
+        double dh = 0, dmu = 0;
+        int k = 0;
+        auto add = [&](const node_type& a, double xa, const node_type& b,
+                       double xb, const node_type& c, double xc) {
+          auto dd = [&](double fa, double fb, double fc) {
+            return ((fc - fb) / (xc - xb) - (fb - fa) / (xb - xa)) / (xc - xa);
+          };
+          dh += dd(to_passive(a.height()), to_passive(b.height()), to_passive(c.height()));
+          dmu += dd(mortality(a), mortality(b), mortality(c));
+          ++k;
+        };
+        if (p > 0) {
+          const node_type& a = sp.node_at(p - 1);
+          add(a, birth(a), lo, x_lo, hi, x_hi);
+        }
+        if (p + 2 < n) {
+          const node_type& c = sp.node_at(p + 2);
+          add(lo, x_lo, hi, x_hi, c, birth(c));
+        } else if (p + 2 == n && closed && t - x_hi > 0.25 * width) {
+          // The boundary node as the third point only once it is clear of the
+          // newest node: at an introduction the two share a birth date.
+          add(lo, x_lo, hi, x_hi, sp.r_new_node(), t);
+        }
+        if (k > 0) {
+          h += dh / k * (m - x_lo) * (m - x_hi);
+          mu += dmu / k * (m - x_lo) * (m - x_hi);
+        }
+      }
+      probe_panel q;
+      q.coefficient = p * field_probe.n_bands() + band;
+      q.lo = &lo;
+      q.hi = &hi;
+      q.lambda = lambda;
+      q.weight = w;
+      q.height = h;
+      q.da = drivers.evaluate("birth_rate", m) * std::exp(-mu) * leaf_area(h);
+      q.lo_height = to_passive(lo.height());
+      q.lo_da = to_passive(lo.get_density()) * leaf_area(q.lo_height);
+      q.hi_height = to_passive(hi.height());
+      q.hi_da = to_passive(hi.get_density()) * leaf_area(q.hi_height);
+      ret.push_back(q);
+    }
+  }
+  return ret;
+}
+
+// The light field's reduction at the knots `x`, with every engaged panel's
+// defect scaled by its coefficient: the finer node's crown, less the shares its
+// neighbours' crowns take of it, at its establishment weight.
+template <typename T, typename E>
+void Patch<T,E>::add_field_probe_light(const std::vector<value_type>& x,
+                                       std::vector<value_type>& y,
+                                       std::vector<value_type>& m) const {
+  using odelia::util::to_passive;
+  const auto& s = *species[0].strategy_ptr();
+  if constexpr (requires { s.pars.k_I; s.pars.eta; }) {
+    const double k_I = to_passive(s.pars.k_I);
+    const double eta = to_passive(s.pars.eta);
+    // A crown of leaf area times density `da` and height H at z: value and
+    // vertical slope of k_I da Q(z / H), Q = (1 - u^eta)^2.
+    auto crown = [&](double da, double H, double z, double& v, double& d) {
+      v = 0.0;
+      d = 0.0;
+      if (!(H > 0) || z > H || !(da > 0)) {
+        return;
+      }
+      const double u_eta = std::pow(z / H, eta);
+      const double tmp = 1.0 - u_eta;
+      v = k_I * da * tmp * tmp;
+      d = z > 0 ? -k_I * da * 2.0 * eta * tmp * u_eta / z : 0.0;
+    };
+    for (const probe_panel& q : probe_panels_now) {
+      const value_type& c = field_probe.light[q.coefficient];
+      const double top = std::max({q.height, q.lo_height, q.hi_height});
+      for (size_t k = 0; k < x.size(); ++k) {
+        const double z = to_passive(x[k]);
+        if (z > top) {
+          break;
+        }
+        double vm, dm, vl, dl, vh, dh;
+        crown(q.da, q.height, z, vm, dm);
+        crown(q.lo_da, q.lo_height, z, vl, dl);
+        crown(q.hi_da, q.hi_height, z, vh, dh);
+        const double dv = q.weight * (vm - (1 - q.lambda) * vl - q.lambda * vh);
+        const double ds = q.weight * (dm - (1 - q.lambda) * dl - q.lambda * dh);
+        if (dv != 0.0) {
+          y[k] += c * (dv / area);
+        }
+        if (ds != 0.0) {
+          m[k] += c * (ds / area);
+        }
+      }
+    }
+  }
+}
+
+// The soil uptake per layer with every engaged panel's defect scaled by its
+// coefficient. The finer node's uptake is its neighbours' per unit leaf area,
+// interpolated, at its own density and leaf area.
+template <typename T, typename E>
+void Patch<T,E>::add_field_probe_soil(std::vector<value_type>& depletion) const {
+  using odelia::util::to_passive;
+  const std::vector<probe_panel> panels = field_probe_panels();
+  for (size_t i = 0; i < depletion.size(); ++i) {
+    for (const probe_panel& q : panels) {
+      const double u_lo = to_passive(q.lo->consumption_rate(i));
+      const double u_hi = to_passive(q.hi->consumption_rate(i));
+      const double r_lo = q.lo_da > 0 ? u_lo / q.lo_da : 0.0;
+      const double r_hi = q.hi_da > 0 ? u_hi / q.hi_da : 0.0;
+      const double u_m = q.mid != nullptr
+                             ? to_passive(q.mid->consumption_rate(i))
+                             : q.da * ((1 - q.lambda) * r_lo + q.lambda * r_hi);
+      const double du = q.weight * (u_m - (1 - q.lambda) * u_lo - q.lambda * u_hi);
+      if (du != 0.0) {
+        depletion[i] += field_probe.soil[q.coefficient] * (du / area);
+      }
+    }
+  }
+}
+
 
