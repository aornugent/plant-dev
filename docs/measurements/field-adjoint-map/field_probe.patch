+#include <plant.h>
+
+// The field probe of Patch::field_probe_type: per panel of species 0's schedule,
+// the finer node's birth date and establishment weight, the time-band breaks,
+// and one coefficient per panel and band for the light field and the soil.
+// With `drop` the run is on the finer schedule and `at` marks its own nodes.
+// [[Rcpp::export]]
+void field_probe_set_tf24(plant::RcppR6::RcppR6<plant::SCM<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_,
+                          std::vector<double> at, std::vector<double> weight,
+                          std::vector<double> bands, int order, bool open,
+                          bool drop, std::vector<double> light,
+                          std::vector<double> soil) {
+  obj_->set_field_probe(at, weight, bands, order, open, drop, light, soil);
+}
