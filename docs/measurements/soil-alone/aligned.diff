+# The build's step taken alone (aligned.diff): odelia's stops and inner step
+# control at 1e-9, one list of inner steps for both passes, plant's soil rates,
+# and the coupling's error through them, each in the build's order of operations.
+STOPS <- c(1 / 5, 0.25, 0.3, 0.5, 3 / 5, 0.75, 7 / 8, 1)
+AH <- c(1 / 5, 0.3, 3 / 5, 1, 7 / 8)
+ALONE_TOL <- 1e-9
+# TF24_Environment::alone_rates: the layers under infiltration and drainage, less
+# uptake u, held at the residual moisture where compute_rates holds them.
+alone_rates <- function(t, th, u) {
+  out <- K_sat * (pmin(pmax(th, 0), theta_s) / theta_s)^q
+  water_in <- c(rain_at(t) * max(0, 1 - (th[1] / theta_s)^b_inf), out[-5])
+  r <- (water_in - out - u) / dz
+  r[th <= theta_res & !(r > 0)] <- 0
+  r
+}
+# OdeControl::adjust_step_size at ALONE_TOL, in fractions of the step: the size it
+# returns and its shrink flag, which, as odelia's, keeps its last value where a
+# step over tolerance cannot shrink.
+inner <- new.env()
+inner_adjust <- function(step, y, yerr, dydt, smin) {
+  rmax <- .Machine$double.xmin
+  for (i in seq_along(y)) {
+    level <- ALONE_TOL * (1 * abs(y[i]) + 0 * abs(step * dydt[i])) + 1e-4 * ALONE_TOL
+    r <- abs(yerr[i]) / abs(level)
+    if (!is.finite(r)) {
+      inner$shrank <- TRUE
+      return(max(step * 0.2, smin))
+    }
+    if (r > rmax) rmax <- r
+  }
+  if (rmax > 1.1) {
+    f <- 0.9 / rmax^(1 / 5)
+    if (f < 0.2) f <- 0.2
+    hn <- step * f
+    if (hn < smin) hn <- smin
+    if (hn < step) {
+      inner$shrank <- TRUE
+      step <- hn
+    }
+  } else if (rmax < 0.5) {
+    f <- 0.9 / rmax^(1 / 6)
+    if (f > 5) f <- 5 else if (f < 1) f <- 1
+    step <- step * f
+    if (step > 1) step <- 1
+    inner$shrank <- FALSE
+  } else {
+    inner$shrank <- FALSE
+  }
+  step
+}
+# Step::alone_ends: where the predictor's inner steps end, chosen at ALONE_TOL
+# under the inputs on the line from u0 to `to`; NULL where the block is not finite
+# at the solver's smallest step, which rejects the step.
+alone_ends <- function(t, h, own, r0, u0, to) {
+  rates <- function(u, b) alone_rates(t + u * h, b, u0 + (to - u0) * u)
+  smin <- ct$ode_step_size_min / h
+  inner$shrank <- FALSE
+  r <- list(r0)
+  ends <- numeric(0)
+  from <- 0
+  piece <- 1
+  for (stop in STOPS) {
+    while (from < stop) {
+      end <- min(from + piece, stop)
+      for (i in 2:6) {
+        r[[i]] <- rates(from + AH[i - 1] * (end - from),
+                        combine(own, tab$ACK[i, ], r, (end - from) * h))
+      }
+      nxt <- combine(own, tab$bCK, r, (end - from) * h)
+      err <- combine(0, tab$bCK - tab$dCK, r, (end - from) * h)
+      asked <- piece
+      piece <- inner_adjust(end - from, nxt, err, r[[1]], smin)
+      if (inner$shrank) {
+        if (!(piece < asked)) return(NULL)
+        next
+      }
+      ends <- c(ends, end)
+      from <- end
+      own <- nxt
+      if (from < 1) r[[1]] <- rates(from, own)
+    }
+  }
+  ends
+}
+# Step::integrate_pieces over the inner steps' ends, the block's rates at the
+# step's start its own: the block at the end and, where kept, at each stop.
+alone_pass <- function(t, h, own, r0, u0, to, ends, keep) {
+  rates <- function(u, b) alone_rates(t + u * h, b, u0 + (to - u0) * u)
+  at <- list()
+  r <- list()
+  from <- 0
+  for (to_u in ends) {
+    if (!(to_u > from)) next
+    r[[1]] <- if (from == 0) r0 else rates(from, own)
+    for (i in 2:6) {
+      r[[i]] <- rates(from + AH[i - 1] * (to_u - from),
+                      combine(own, tab$ACK[i, ], r, (to_u - from) * h))
+    }
+    own <- combine(own, tab$bCK, r, (to_u - from) * h)
+    if (keep && length(at) < length(STOPS) && to_u == STOPS[length(at) + 1]) {
+      at[[length(at) + 1]] <- own
+    }
+    from <- to_u
+  }
+  list(end = own, at = at)
 }
 
