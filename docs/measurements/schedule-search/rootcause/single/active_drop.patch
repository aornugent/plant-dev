+template <typename T, typename E>
+typename Species<T,E>::value_type Species<T,E>::drop_census(size_t j) const {
+  const drop_shares s = shares_around(j);
+  auto fate = [&](size_t i) -> value_type {
+    return nodes[i].weighted_fecundity(strategy->pars.S_D) *
+           extrinsic_drivers().evaluate("birth_rate",
+                                        nodes[i].introduction_time());
+  };
+  const value_type ret = (s.spanning.first - s.below.first) * fate(j - 1) +
+                         (s.spanning.second - s.above.second) * fate(j + 1) -
+                         (s.below.second + s.above.first) * fate(j);
+  return ret;
+}
