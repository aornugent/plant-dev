 template <typename T, typename E>
+typename Patch<T,E>::value_type Patch<T,E>::node_drop_census() const {
+  value_type ret(0.0);
+  for (size_t j : node_drop.nodes) {
+    if (j + 1 >= species[0].size()) {
+      break;
+    }
+    ret += species[0].drop_census(j);
+  }
+  return ret;
+}
