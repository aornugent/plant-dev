+  // Seconds per rate evaluation at the last recorded state, every leaf solved:
+  // at double, at a tangent of width 1 and of width 5, and recorded at the
+  // adjoint scalar with one transpose row swept.
+  std::vector<double> rate_cost(int reps) {
+    using clock = std::chrono::steady_clock;
+    const trajectory rec = store_trajectory();
+    const size_t at = rec.size() - 1;
+    const std::vector<double>& state = rec[at].state;
+    const double when = odelia::ode::at_state_time(rec, at);
+    const auto& solved = rec[at].solved.at_state;
+    const bool was = leaf_resolve_on_replay;
+    leaf_resolve_on_replay = true;
+    auto seconds = [&](auto&& f) {
+      const auto t0 = clock::now();
+      for (int r = 0; r < reps; ++r) {
+        f();
+      }
+      return std::chrono::duration<double>(clock::now() - t0).count() / reps;
+    };
+    std::vector<double> ret;
+    {
+      patch_type p = patch;
+      std::vector<double> rates(state.size());
+      ret.push_back(seconds([&] {
+        odelia::ode::derivs(p, state, rates, when, std::as_const(solved));
+      }));
+    }
+    auto at_scalar_type = [&](auto tag) {
+      using U = decltype(tag);
+      auto p = patch.template rebind_from<U>();
+      std::vector<U> x(state.begin(), state.end()), rates(state.size());
+      return seconds([&] {
+        odelia::ode::derivs(p, x, rates, when, std::as_const(solved));
+      });
+    };
+    ret.push_back(at_scalar_type(tangent{}));
+    ret.push_back(at_scalar_type(typename xad::fwd<double, 5>::active_type{}));
+    {
+      using scalar = odelia::ode::active_scalar<double>;
+      const auto seed = odelia::ode::adjoint_rows::one_row(
+        std::vector<double>(state.size(), 1.0));
+      odelia::ode::adjoint_rows st, tr(1, patch.trait_adjoint_size());
+      auto reduce = [&](auto& active,
+                        typename std::vector<scalar>::const_iterator x,
+                        std::vector<scalar>& y) -> void {
+        const std::vector<scalar> in(
+          x, x + static_cast<std::ptrdiff_t>(state.size()));
+        odelia::ode::derivs(active, in, y, when, std::as_const(solved));
+      };
+      ret.push_back(seconds([&] {
+        odelia::ode::state_and_parameter_adjoints(patch, state, seed, reduce,
+                                                  st, tr);
+      }));
+    }
+    leaf_resolve_on_replay = was;
+    return ret;
+  }
 
