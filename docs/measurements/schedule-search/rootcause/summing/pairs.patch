+  // on the hat weights; =quad builds each selected pair's crowns from the quadratic
+  // through its three nodes (tops and leaf areas) instead of adding the corrections.
+  struct pair_rule_setting {
+    int mode;  // 0 off, 1 all, 2 windows
+    std::vector<std::pair<double, double>> windows;
+    bool light;
+    bool light_quad;  // PLANT_SIMPSON_LIGHT=quad
+    bool moment;  // PLANT_SIMPSON_FORM=moment
+  };
+  static const pair_rule_setting& pair_rule() {
+    static const pair_rule_setting setting = [] {
+      pair_rule_setting r{0, {}, true, false, false};
+      const char* v = std::getenv("PLANT_SIMPSON");
+      if (v != nullptr && *v != 0 && std::strcmp(v, "off") != 0) {
+        if (std::strcmp(v, "all") == 0) {
+          r.mode = 1;
+        } else {
+          r.mode = 2;
+          std::string s(v);
+          std::size_t at = 0;
+          while (at < s.size()) {
+            std::size_t comma = s.find(',', at);
+            if (comma == std::string::npos) comma = s.size();
+            const std::string item = s.substr(at, comma - at);
+            const std::size_t colon = item.find(':');
+            if (colon == std::string::npos) {
+              util::stop("PLANT_SIMPSON: expected off, all or lo:hi[,lo:hi]");
+            }
+            r.windows.emplace_back(std::atof(item.substr(0, colon).c_str()),
