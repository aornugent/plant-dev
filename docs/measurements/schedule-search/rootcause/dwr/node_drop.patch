+template <typename T, typename E>
+typename Species<T,E>::drop_shares Species<T,E>::shares_around(size_t j) const {
+  using odelia::util::to_passive;
+  const double t = nodes.at(j).introduction_time();
+  const double h_below = t - nodes.at(j - 1).introduction_time();
+  const double h_above = nodes.at(j + 1).introduction_time() - t;
+  const auto passive = [](const std::pair<value_type, value_type>& s) {
+    return std::make_pair(to_passive(s.first), to_passive(s.second));
+  };
+  drop_shares ret{passive(nodes[j - 1].interval_shares(h_below)),
+                  passive(nodes[j].interval_shares(h_above)), {}};
+  // The spanning interval holds both counts, and the first moments about its
+  // lower end: the upper one's shifted by h_below.
+  const double above = ret.above.first + ret.above.second;
+  const double moment = ret.below.second * h_below +
+                        ret.above.second * h_above + above * h_below;
+  ret.spanning.second = moment / (h_below + h_above);
+  ret.spanning.first = ret.below.first + ret.below.second + above -
+                       ret.spanning.second;
+  return ret;
+}
+
+template <typename T, typename E>
+std::vector<std::pair<double, double>>
+Species<T,E>::drop_crowns(size_t j) const {
+  using odelia::util::to_passive;
+  const drop_shares s = shares_around(j);
+  std::vector<std::pair<double, double>> ret;
+  ret.reserve(3 * crowns_per_interval);
+  auto add = [&](const node_type& node, const node_type& end,
+                 const std::pair<double, double>& share, double sign) {
+    for_each_interval_crown(
+      node, end, {value_type(share.first), value_type(share.second)},
+      [&](const value_type& top, const value_type& leaf_area) {
+        ret.emplace_back(to_passive(top), sign * to_passive(leaf_area));
+      });
+  };
+  add(nodes[j - 1], nodes[j + 1], s.spanning, 1.0);
+  add(nodes[j - 1], nodes[j], s.below, -1.0);
+  add(nodes[j], nodes[j + 1], s.above, -1.0);
+  return ret;
+}
+
+// The change in the three nodes' establishment weights, times their uptake.
+template <typename T, typename E>
+std::vector<double> Species<T,E>::drop_uptake(size_t j, size_t n_layers) const {
+  using odelia::util::to_passive;
+  const drop_shares s = shares_around(j);
+  std::vector<double> ret(n_layers);
+  for (size_t i = 0; i < n_layers; ++i) {
+    const int layer = static_cast<int>(i);
+    ret[i] = (s.spanning.first - s.below.first) *
+               to_passive(nodes[j - 1].consumption_rate(layer)) +
+             (s.spanning.second - s.above.second) *
+               to_passive(nodes[j + 1].consumption_rate(layer)) -
+             (s.below.second + s.above.first) *
+               to_passive(nodes[j].consumption_rate(layer));
+  }
+  return ret;
+}
