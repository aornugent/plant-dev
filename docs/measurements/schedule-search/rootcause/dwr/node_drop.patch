+#include <plant.h>
+
+// Species 0's field with nodes `nodes` (counting from one) dropped, their light
+// and uptake changes scaled per node and time band (Patch::node_drop_type).
+// [[Rcpp::export]]
+void node_drop_set_tf24(plant::RcppR6::RcppR6<plant::SCM<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_,
+                        std::vector<int> nodes, std::vector<double> bands,
+                        std::vector<double> light, std::vector<double> soil) {
+  std::vector<size_t> from_zero;
+  for (int j : nodes) {
+    if (j < 1) {
+      plant::util::stop("node_drop_set_tf24: nodes count from one");
+    }
+    from_zero.push_back(static_cast<size_t>(j - 1));
+  }
+  obj_->set_node_drop(from_zero, bands, light, soil);
