+template <typename T, typename E>
+void Patch<T,E>::set_node_drop(const std::vector<size_t>& nodes,
+                               const std::vector<double>& bands,
+                               const std::vector<double>& light,
+                               const std::vector<double>& soil) {
+  util::check_length(light.size(), nodes.size() * (bands.size() + 1));
+  util::check_length(soil.size(), light.size());
+  for (size_t k = 0; k < nodes.size(); ++k) {
+    if (nodes[k] == 0 || (k > 0 && nodes[k] <= nodes[k - 1] + 1)) {
+      util::stop("set_node_drop: each dropped node needs a kept node either "
+                 "side, in ascending order");
+    }
+  }
+  if (!std::is_sorted(bands.begin(), bands.end())) {
+    util::stop("set_node_drop: the band breaks must ascend");
+  }
+  node_drop.nodes = nodes;
+  node_drop.bands = bands;
+  node_drop.light.assign(light.begin(), light.end());
+  node_drop.soil.assign(soil.begin(), soil.end());
+}
+
+template <typename T, typename E>
+bool Patch<T,E>::node_drop_engaged() const {
+  if (node_drop.nodes.empty() ||
+      (loading != nullptr && loading->field != nullptr)) {
+    return false;
+  }
+  if constexpr (std::is_same_v<value_type, double>) {
+    const auto nonzero = [](double c) { return c != 0.0; };
+    return std::any_of(node_drop.light.begin(), node_drop.light.end(),
+                       nonzero) ||
+           std::any_of(node_drop.soil.begin(), node_drop.soil.end(), nonzero);
+  }
+  return true;
+}
+
+template <typename T, typename E>
+size_t Patch<T,E>::node_drop_band() const {
+  return static_cast<size_t>(
+    std::upper_bound(node_drop.bands.begin(), node_drop.bands.end(),
+                     environment.time) - node_drop.bands.begin());
+}
+
+// Each dropped node's crowns summed at the knots through prefix sums of their
+// moments, as Species::field_splits sums the field's own.
+template <typename T, typename E>
+void Patch<T,E>::add_node_drop_light(const std::vector<value_type>& x,
+                                     std::vector<value_type>& y,
+                                     std::vector<value_type>& m) const {
+  using odelia::util::to_passive;
+  using moments = std::array<value_type, CanopyShape<value_type>::max_moments>;
+  using passive_moments =
+    std::array<double, CanopyShape<value_type>::max_moments>;
+  const auto& shape = species[0].strategy_ptr()->canopy_shape;
+  const size_t n_moments = shape.n_moments();
+  if (n_moments == 0) {
+    util::stop("The node drop needs a canopy profile in moments");
+  }
+  moments a;
+  auto passive = [&]() {
+    passive_moments ret{};
+    for (size_t q = 0; q < n_moments; ++q) {
+      ret[q] = to_passive(a[q]);
+    }
+    return ret;
+  };
+  std::vector<passive_moments> weight(x.size()), weight_slope(x.size());
+  for (size_t k = 0; k < x.size(); ++k) {
+    const value_type z(to_passive(x[k]));
+    shape.height_weights(z, a);
+    weight[k] = passive();
+    shape.height_weight_slopes(z, a);
+    weight_slope[k] = passive();
+  }
+  const size_t band = node_drop_band();
+  const size_t n_bands = node_drop.bands.size() + 1;
+  for (size_t d = 0; d < node_drop.nodes.size(); ++d) {
+    const size_t j = node_drop.nodes[d];
+    if (j + 1 >= species[0].size()) {
+      break;
+    }
+    std::vector<std::pair<double, double>> crowns = species[0].drop_crowns(j);
+    std::sort(crowns.begin(), crowns.end(),
+              [](const auto& a, const auto& b) { return a.first > b.first; });
+    // prefix[i] sums the i tallest crowns.
+    std::vector<passive_moments> prefix(crowns.size() + 1, passive_moments{});
+    for (size_t i = 0; i < crowns.size(); ++i) {
+      shape.crown_moments(value_type(1.0 / crowns[i].first), a);
+      const passive_moments mom = passive();
+      for (size_t q = 0; q < n_moments; ++q) {
+        prefix[i + 1][q] = prefix[i][q] + crowns[i].second * mom[q];
+      }
+    }
+    const value_type& c = node_drop.light[d * n_bands + band];
+    size_t reach = crowns.size();
+    for (size_t k = 0; k < x.size(); ++k) {
+      const double z = to_passive(x[k]);
+      while (reach > 0 && crowns[reach - 1].first < z) {
+        --reach;
+      }
+      if (reach == 0) {
+        break;
+      }
+      double value = 0.0, slope = 0.0;
+      for (size_t q = 0; q < n_moments; ++q) {
+        value += weight[k][q] * prefix[reach][q];
+        slope += weight_slope[k][q] * prefix[reach][q];
+      }
+      y[k] += c * (value / area);
+      m[k] += c * (slope / area);
+    }
+  }
+}
+
+template <typename T, typename E>
+void Patch<T,E>::add_node_drop_uptake(
+    std::vector<value_type>& depletion) const {
+  const size_t band = node_drop_band();
+  const size_t n_bands = node_drop.bands.size() + 1;
+  for (size_t d = 0; d < node_drop.nodes.size(); ++d) {
+    const size_t j = node_drop.nodes[d];
+    if (j + 1 >= species[0].size()) {
+      break;
+    }
+    const std::vector<double> gain =
+      species[0].drop_uptake(j, depletion.size());
+    const value_type& c = node_drop.soil[d * n_bands + band];
+    for (size_t i = 0; i < depletion.size(); ++i) {
+      depletion[i] += c * (gain[i] / area);
+    }
+  }
+}
