+# The dense output of the attempt `a` of size h from (t0, y0) with rates f0 there,
+# as a function of the fraction u of the step; NULL where the quintic's midpoint
+# raises. dp4 and ck4 read the stages' rates and the rates at the step's end.
+dense_of <- function(t0, y0, f0, a, h, kind = DENSE) {
+  y1 <- a$y; f1 <- a$rates
+  switch(kind,
+    cubic = function(u) (1 + 2 * u) * (1 - u)^2 * y0 + u * (1 - u)^2 * h * f0 +
+      u^2 * (3 - 2 * u) * y1 + u^2 * (u - 1) * h * f1,
+    quintic = {
+      mid <- attempt(t0, y0, f0, h / 2)
+      if (is.null(mid)) return(NULL)
+      ym <- mid$y; fm <- mid$rates
+      function(u) {
+        w <- quintic_weights(u)
+        w[1] * y0 + w[2] * h * f0 + w[3] * ym + w[4] * h * fm + w[5] * y1 + w[6] * h * f1
+      }
+    },
+    dp4 = {
+      r2 <- y1 - y0; r3 <- h * f0 - r2; r4 <- r2 - h * f1 - r3
+      r5 <- combine(0, tab$eDP, c(a$k, list(f1)), h)
+      function(u) y0 + u * (r2 + (1 - u) * (r3 + u * (r4 + (1 - u) * r5)))
+    },
+    ck4 = {
+      K <- do.call(cbind, c(a$k, list(f1)))
+      function(u) y0 + h * as.vector(K %*% as.vector(u^(1:4) %*% tab$BCK4))
+    })
 }
 
