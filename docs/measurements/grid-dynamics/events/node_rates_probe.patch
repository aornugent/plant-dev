+template <typename T, typename E>
+std::vector<double> Patch<T,E>::r_node_rates(const std::vector<double>& y,
+                                             double time,
+                                             util::index species_index,
+                                             util::index node_index) {
+  util::check_length(y.size(), ode_size());
+  species_type& s = species[species_index.check_bounds(size())];
+  const size_t j = node_index.check_bounds(s.size());
+  set_ode_state(y.begin(), time);
+  s.compute_node_rates(j, environment, survival_weighting->pr_survival(time),
+                       s.extrinsic_drivers().evaluate("birth_rate", time));
+  const node_type& node = *(s.node_begin() + j);
+  std::vector<double> ret(node.ode_size() + node.aux_size());
+  node.ode_aux(node.ode_rates(ret.begin()));
+  return ret;
+}
