new file mode 100644
index 00000000..af1c56b1
--- /dev/null
+++ b/src/node_rates_probe.cpp
@@ -0,0 +1,22 @@
+#include <plant.h>
+
+// One node's rates, then its auxiliaries, at the state `y` and `time`: the
+// field that state builds, with no other node rated (Patch::r_node_rates).
+// [[Rcpp::export]]
+std::vector<double> patch_node_rates_tf24(plant::RcppR6::RcppR6<plant::Patch<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_,
+                                          std::vector<double> y, double time,
+                                          plant::util::index species_index,
+                                          plant::util::index node_index) {
+  return obj_->r_node_rates(y, time, species_index, node_index);
+}
+
+// The leaf solves species i's strategy has run, by the kind of operating point
+// each placed. Every node of a species and its boundary node share the strategy.
+// [[Rcpp::export]]
+std::vector<double> patch_leaf_solves_tf24(plant::RcppR6::RcppR6<plant::Patch<plant::TF24_Strategy<double>, plant::TF24_Environment<double> > > obj_,
+                                           plant::util::index species_index) {
+  const size_t i = species_index.check_bounds(obj_->size());
+  const std::vector<size_t>& counts =
+    obj_->at_species(i).strategy_ptr()->operating_point_counts;
+  return std::vector<double>(counts.begin(), counts.end());
+}
