+COUPLING <- match.arg(Sys.getenv("COUPLING", "held"), c("held", "exact", "exactx", "stage", "defect", "stagelin", "pc", "rec", "recsoil"))
+# rec: the soil's draw read from a recording of the tol 1e-7 monolithic run (REC,
+# from record_uptake.R), whatever soil the sub-cycle holds; recsoil: no soil
+# sub-cycle, the member stages read the recorded soil itself. The recorded soil
+# is each step's cubic Hermite interpolant, and the recorded draw the one that
+# interpolant implies through the soil's balance.
+if (COUPLING %in% c("rec", "recsoil")) {
+  rec <- readRDS(Sys.getenv("REC"))
+  rec_t <- c(0, rec$time)
+  rec_s <- rbind(rec$init$soil, rec$soil)
+  rec_r <- rbind(rec$init$rate, rec$rate)
+}
+rec_soil_at <- function(tt) {
+  j <- findInterval(tt, rec_t, rightmost.closed = TRUE)
+  j <- min(max(j, 1L), length(rec_t) - 1L)
+  h <- rec_t[j + 1] - rec_t[j]
+  u <- (tt - rec_t[j]) / h
+  th <- (1 + 2 * u) * (1 - u)^2 * rec_s[j, ] + u * (1 - u)^2 * h * rec_r[j, ] +
+    u^2 * (3 - 2 * u) * rec_s[j + 1, ] + u^2 * (u - 1) * h * rec_r[j + 1, ]
+  dth <- (6 * u^2 - 6 * u) / h * rec_s[j, ] + (1 - 4 * u + 3 * u^2) * rec_r[j, ] +
+    (6 * u - 6 * u^2) / h * rec_s[j + 1, ] + (3 * u^2 - 2 * u) * rec_r[j + 1, ]
+  list(theta = th, rate = dth)
+}
