+# The draw the recorded soil implies at time tt: inflow less drainage less dz
+# times the interpolant's slope, layer by layer.
+rec_uptake <- function(th, tt) {
+  r <- rec_soil_at(tt)
+  s <- r$theta
+  rain <- max(0, env$extrinsic_drivers_evaluate("rainfall", tt))
+  infil <- rain * max(0, 1 - e_a_inf * (s[1] / e_theta_s)^e_b_inf)
+  K <- e_K_sat * (pmin(pmax(s, 0), e_theta_s) / e_theta_s)^e_q
+  c(infil, K[1:4]) - K - e_dz * r$rate
+}
