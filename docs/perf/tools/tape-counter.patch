@@ -15,6 +15,43 @@
 namespace odelia {
 namespace ode {
 
+// THROWAWAY INSTRUMENTATION -- not for landing. One tally per reverse-mode
+// recording taken through the two transposes below, read by plant's
+// ladder_boundary_evaluations_tf24. Statements and operations rather than bytes:
+// getMemory conflates the count with chunk allocation.
+namespace tapecount {
+
+struct totals {
+  unsigned long long statements = 0;
+  unsigned long long operations = 0;
+  unsigned long long sweeps = 0;
+  unsigned long long max_statements = 0;
+  unsigned long long max_operations = 0;
+};
+
+inline totals& counts() {
+  static totals t;
+  return t;
+}
+
+// Called after the recording and its sweeps, before the next clearAll(), so the
+// numbers are this recording's own.
+template <class TapeType>
+inline void record(const TapeType& tape) {
+  totals& t = counts();
+  const unsigned long long s =
+      static_cast<unsigned long long>(tape.getNumStatements());
+  const unsigned long long o =
+      static_cast<unsigned long long>(tape.getNumOperations());
+  t.statements += s;
+  t.operations += o;
+  ++t.sweeps;
+  if (s > t.max_statements) t.max_statements = s;
+  if (o > t.max_operations) t.max_operations = o;
+}
+
+}
