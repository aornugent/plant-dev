--- a/inst/include/plant/patch.h
+++ b/inst/include/plant/patch.h
@@ -11,6 +11,9 @@
 
 #include <algorithm>
 #include <limits>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
 
 using namespace Rcpp;
 
@@ -628,6 +631,34 @@ void Patch<T,E>::introduce_new_nodes(const std::vector<size_t>& species_index) {
   }
 
   compute_environment(false);
+
+  static const bool k1_fix   = std::getenv("PLANT_K1_FIX")   != nullptr;
+  static const bool k1_probe = std::getenv("PLANT_K1_PROBE") != nullptr;
+  if (k1_fix) {
+    compute_rates();
+  }
+  if (k1_probe) {
+    const size_t n_ode = ode_size();
+    const size_t n_env = environment.ode_size();
+    const size_t n_new = species_index.empty() ? 0 : node_type::ode_size();
+    std::vector<double> before(n_ode, 0.0);
+    ode_rates(before.begin());
+    compute_rates();
+    std::vector<double> after(n_ode, 0.0);
+    ode_rates(after.begin());
+    const size_t cohort_end = n_ode - n_env;
+    const size_t born_begin = cohort_end > n_new ? cohort_end - n_new : 0;
+    double d_old = 0.0, d_new = 0.0, d_env = 0.0, r_old = 0.0;
+    for (size_t i = 0; i < n_ode; ++i) {
+      const double d = std::abs(after[i] - before[i]);
+      const double scale = std::abs(after[i]) > 1e-300 ? std::abs(after[i]) : 1.0;
+      if (i >= cohort_end)      d_env = std::max(d_env, d);
+      else if (i >= born_begin) d_new = std::max(d_new, d);
+      else { d_old = std::max(d_old, d); r_old = std::max(r_old, d / scale); }
+    }
+    std::fprintf(stderr, "K1 %.8e %zu %.6e %.6e %.6e %.6e\n",
+                 t, n_ode, d_old, d_new, d_env, r_old);
+  }
 }
 
 template <typename T, typename E>
