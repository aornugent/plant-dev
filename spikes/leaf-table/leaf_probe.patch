+// Pilot instrumentation for spikes/leaf-table: counts and times TF24 leaf
+// solves, and writes the leaf's inputs and outputs at a sampled fraction of
+// calls. Inert unless PLANT_LEAF_STATS / PLANT_LEAF_LOG are set.
+#ifndef PLANT_PLANT_LEAF_PROBE_H_
+#define PLANT_PLANT_LEAF_PROBE_H_
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+namespace plant {
+namespace leaf_probe {
+
+struct Stats {
+  unsigned long long solved = 0, replayed = 0;
+  double solved_ns = 0, replayed_ns = 0;
+  unsigned long long logged = 0, seen = 0;
+  long every = 1;
+  FILE* log = nullptr;
+  bool replay_flag = false;
+  Stats() {
+    if (const char* p = std::getenv("PLANT_LEAF_LOG")) {
+      std::string f = std::string(p) + "." + std::to_string(getpid()) + ".bin";
+      log = std::fopen(f.c_str(), "wb");
+    }
+    if (const char* e = std::getenv("PLANT_LEAF_LOG_EVERY")) every = std::atol(e);
+  }
+  ~Stats() {
+    if (log) std::fclose(log);
+    if (const char* p = std::getenv("PLANT_LEAF_STATS")) {
+      std::string f = std::string(p) + "." + std::to_string(getpid()) + ".txt";
+      if (FILE* o = std::fopen(f.c_str(), "w")) {
+        std::fprintf(o, "solved %llu %.6e\nreplayed %llu %.6e\n", solved,
+                     solved_ns * 1e-9, replayed, replayed_ns * 1e-9);
+        std::fclose(o);
+      }
+    }
+  }
+};
+
+inline Stats& stats() {
+  static Stats s;
+  return s;
+}
+
+// A P table over (light, asinh(psi_1/psi0), asinh(psi_deep/psi0), log h),
+// read multilinearly, standing in for the solved P of the one species whose
+// vcmax_25 equals PLANT_LEAF_KEY. PLANT_LEAF_PSCALE instead scales that
+// species' solved P.
+struct Table {
+  bool on = false, scale_on = false;
+  double key = 0, psi0 = 1, scale = 1;
+  std::vector<int> n;
+  std::vector<std::vector<double>> axes;
+  std::vector<double> P;
+  Table() {
+    const char* k = std::getenv("PLANT_LEAF_KEY");
+    if (!k) return;
+    key = std::atof(k);
+    if (const char* sc = std::getenv("PLANT_LEAF_PSCALE")) {
+      scale_on = true;
+      scale = std::atof(sc);
+    }
+    const char* f = std::getenv("PLANT_LEAF_TABLE");
+    if (!f) return;
+    FILE* in = std::fopen(f, "rb");
+    if (!in) return;
+    std::vector<double> x;
+    double v;
+    while (std::fread(&v, sizeof(double), 1, in) == 1) x.push_back(v);
+    std::fclose(in);
+    size_t i = 1;
+    psi0 = x[i++];
+    const int nd = static_cast<int>(x[i++]);
+    for (int j = 0; j < nd; ++j) n.push_back(static_cast<int>(x[i++]));
+    for (int j = 0; j < nd; ++j) {
+      axes.emplace_back(x.begin() + i, x.begin() + i + n[j]);
+      i += n[j];
+    }
+    P.assign(x.begin() + i, x.end());
+    on = true;
+  }
+  bool matches(double vcmax) const { return vcmax == key; }
+  double operator()(const double* X) const {
+    const int nd = static_cast<int>(n.size());
+    int lo[8];
+    double fr[8];
+    for (int j = 0; j < nd; ++j) {
+      const std::vector<double>& a = axes[j];
+      const double x = std::min(std::max(X[j], a.front()), a.back());
+      int k = static_cast<int>(std::upper_bound(a.begin(), a.end(), x) - a.begin()) - 1;
+      k = std::max(0, std::min(k, n[j] - 2));
+      lo[j] = k;
+      fr[j] = (x - a[k]) / (a[k + 1] - a[k]);
+    }
+    double out = 0;
+    for (int c = 0; c < (1 << nd); ++c) {
+      size_t idx = 0, stride = 1;
+      double w = 1;
+      for (int j = 0; j < nd; ++j) {
+        const int b = (c >> j) & 1;
+        idx += (lo[j] + b) * stride;
+        stride *= n[j];
+        w *= b ? fr[j] : 1 - fr[j];
+      }
+      out += w * P[idx];
+    }
+    return out;
+  }
+};
+
+inline Table& table() {
+  static Table t;
+  return t;
+}
+
+// Rows of 32 doubles: written by the caller, padded with NaN.
+constexpr int ROW = 32;
+inline void write_row(const double* x, int n) {
+  Stats& s = stats();
+  if (!s.log) return;
+  if ((s.seen++ % s.every) != 0) return;
+  double row[ROW];
+  for (int i = 0; i < ROW; ++i) row[i] = i < n ? x[i] : std::nan("");
+  std::fwrite(row, sizeof(double), ROW, s.log);
+  ++s.logged;
+}
+
+}  // namespace leaf_probe
+}  // namespace plant
+
+#endif
