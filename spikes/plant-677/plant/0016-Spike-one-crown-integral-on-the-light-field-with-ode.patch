+  // The integral over a crown of height `height` of phi(E, p...), E the field at
+  // each depth: the sum of crown.weight[j] * phi(E(height * crown.fraction[j]),
+  // p...), each E read as get_value_at_fraction reads it. phi is written once,
+  // over its scalar.
+  //
+  // At an active scalar the sum is taken at double, so it is the passive sum bit
+  // for bit, and recorded as one statement. Its rows on the knot data are each
+  // read's own, scaled by phi's slope in E; on the height and the canopy top they
+  // come through each read's position; on p, from one tangent of phi per read.
+  template <class Phi, class... P>
+  S crown_integral(const S& height, const crown_rule& crown, Phi phi,
+                   const P&... p) const {
+    const double cap = max_height();
+    if constexpr (!odelia::CarriesAdjoint<S>) {
+      S total = 0.0;
+      for (std::size_t j = 0; j < crown.fraction.size(); ++j) {
+        total += crown.weight[j] *
+                 phi(get_value_at_fraction(height, crown.fraction[j], cap), p...);
+      }
+      return total;
+    } else {
+      static_assert((std::is_same_v<P, S> && ...),
+                    "crown_integral: phi's parameters carry the field's scalar");
+      using odelia::util::to_passive;
+      const double h = to_passive(height), top = to_passive(height_max_);
+      // Four rows a read, then the height, the canopy top and p: bounded by the
+      // largest rule, so they are held here and nothing is allocated per crown.
+      constexpr std::size_t max_rows =
+          4 * quadrature::QK::max_points + 2 + sizeof...(P);
+      std::array<const S*, max_rows> inputs;
+      std::array<double, max_rows> derivatives;
+      std::size_t n = 0;
+      double total = 0.0, d_height = 0.0, d_top = 0.0;
+      std::array<double, sizeof...(P)> d_p{};
+      for (std::size_t j = 0; j < crown.fraction.size(); ++j) {
+        const double s = crown.fraction[j];
+        // Open above the canopy top and floored at zero, as the passive read is;
+        // neither constant depends on the knots or the read's position.
+        double E = 1.0;
+        bool on_field = h * s <= cap;
+        typename decltype(spline)::linear_read read{};
+        if (on_field) {
+          read = spline.read_linear(h * s / top);
+          on_field = 0.0 < read.value;
+          E = on_field ? read.value : 0.0;
+        }
+        const auto f = odelia::ode::value_and_partials(phi, E, to_passive(p)...);
+        total += crown.weight[j] * f.value;
+        for (std::size_t i = 0; i < sizeof...(P); ++i) {
+          d_p[i] += crown.weight[j] * f.partial[i + 1];
+        }
+        if (on_field) {
+          const double g = crown.weight[j] * f.partial[0];
+          for (std::size_t i = 0; i < read.input.size(); ++i) {
+            inputs[n] = read.input[i];
+            derivatives[n++] = g * read.weight[i];
+          }
+          d_height += g * read.slope * (s / top);
+          d_top -= g * read.slope * (h * s / top / top);
+        }
+      }
+      inputs[n] = &height;
+      derivatives[n++] = d_height;
+      inputs[n] = &height_max_;
+      derivatives[n++] = d_top;
+      const std::array<const S*, sizeof...(P)> parameters{&p...};
+      for (std::size_t i = 0; i < sizeof...(P); ++i) {
+        inputs[n] = parameters[i];
+        derivatives[n++] = d_p[i];
+      }
+      S out;
+      const odelia::record_report report = odelia::record_with_derivatives<S>(
+          total, std::span<const S* const>(inputs.data(), n),
+          std::span<const double>(derivatives.data(), n), out);
+      if (!report.whole) {
+        util::stop("crown_integral: " + report.why);
+      }
+      return out;
+    }
+  }
