-  std::pair<S, S> Q_and_q_softbox(S z_over_height, S height_inverse) const {
+  std::pair<S, S> Q_and_q_softbox(const S& z_over_height,
+                                  const S& height_inverse) const {
     const S lo = eta_c_ > 0.5 ? 2.0 * eta_c_ - 1.0 : S(0.0);
     if (z_over_height <= lo) {
       return {S(1.0), S(0.0)};
