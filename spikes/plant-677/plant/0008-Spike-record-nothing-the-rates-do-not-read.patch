diff --git a/inst/include/plant/canopy_shape.h b/inst/include/plant/canopy_shape.h
index a3159b73..7ff02e85 100644
--- a/inst/include/plant/canopy_shape.h
+++ b/inst/include/plant/canopy_shape.h
@@ -203,6 +203,11 @@ public:
       return {b * ((k * a) * ((1.0 - u_eta) * (1.0 - u_eta))),
               b * (-((k * a) * (2.0 * eta_ * (1.0 - u_eta) * u_eta / z)))};
     }
+    // Above the crown both are zero whatever scales them, and scaling a
+    // passive zero by active factors records a statement for nothing.
+    if (z_over_height > 1.0) {
+      return Q_and_q(z_over_height, z, height_inverse);
+    }
     const S scale = k * a;
     const std::pair<S, S> Qq = Q_and_q(z_over_height, z, height_inverse);
     return {b * (scale * Qq.first), b * (-(scale * Qq.second))};
