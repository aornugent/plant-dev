diff --git a/inst/include/plant/patch.h b/inst/include/plant/patch.h
index db629d3b..acfea2b0 100644
--- a/inst/include/plant/patch.h
+++ b/inst/include/plant/patch.h
@@ -1442,6 +1442,12 @@ void Patch<T,E>::compute_environment_excl_capturing() {
   // The reduction fills one entry per knot, so the only thing needed here is one
   // vector per species; field_splits sizes each of them.
   competition_capture.resize(size());
+  // This field is read only by the boundary nodes, each at or below its own
+  // height, so it is built only up to the tallest of them.
+  double read_below = 0.0;
+  for (const auto& s : species) {
+    read_below = std::max(read_below, odelia::util::to_passive(s.r_new_node().height()));
+  }
   auto f = [&](const std::vector<value_type>& x, std::vector<value_type>& y,
                std::vector<value_type>& m) -> void {
     for (size_t k = 0; k < x.size(); ++k) {
@@ -1453,7 +1459,7 @@ void Patch<T,E>::compute_environment_excl_capturing() {
     // set, and asking it per knot is what made the build quadratic.
     for (size_t i = 0; i < size(); ++i) {
       species[i].field_splits(x, competition_capture[i]);
-      for (size_t k = 0; k < x.size(); ++k) {
+      for (size_t k = 0; k < x.size() && knot_built(x, k, read_below); ++k) {
         // without_boundary()'s halves, inside the sums rather than named.
         const auto& sum = competition_capture[i][k].sum;
         y[k] += (sum.value / 2) / area;
@@ -1462,7 +1468,7 @@ void Patch<T,E>::compute_environment_excl_capturing() {
     }
   };
   if (size() > 0) {
-    environment.compute_environment(f, height_max());
+    environment.compute_environment(f, height_max(), read_below);
   }
 }
 
diff --git a/inst/include/plant/resource_spline.h b/inst/include/plant/resource_spline.h
index a4d0c648..74c88f9b 100644
--- a/inst/include/plant/resource_spline.h
+++ b/inst/include/plant/resource_spline.h
@@ -14,6 +14,15 @@ using namespace Rcpp;
 
 namespace plant {
 
+// A field read only at or below `read_below` is built only there: a knot is
+// built when the one beneath it is at or below that height, so every span a read
+// can reach has both its knots. Above, the reduction leaves passive zeros and
+// nothing is recorded for them; their spans hold no light and must not be read.
+template <typename S>
+bool knot_built(const std::vector<S>& x, std::size_t k, double read_below) {
+  return k == 0 || odelia::util::to_passive(x[k - 1]) <= read_below;
+}
+
 // Templated on the scalar S the resource values carry; the knot positions stay
 // double. S = double is production.
 //
@@ -51,7 +60,8 @@ public:
   // that produces the values is linear in the nodes plus the knots and quadratic
   // only if it is asked per knot.
   template <typename Function>
-  void compute_environment(Function f_all_knots, S height_max) {
+  void compute_environment(Function f_all_knots, S height_max,
+                           double read_below = R_PosInf) {
     lay_out_knots();
     height_max_ = height_max;
     // The reduction is asked at the knots' HEIGHTS, and they are active: a knot
@@ -67,7 +77,9 @@ public:
     f_all_knots(x, y, m);
     // The reduction's slope is per unit height and the interpolant's abscissa is
     // u, so the chain factor is the canopy top itself.
-    for (size_t k = 0; k < n; ++k) { m[k] = m[k] * height_max; }
+    for (size_t k = 0; k < n && knot_built(x, k, read_below); ++k) {
+      m[k] = m[k] * height_max;
+    }
     spline.set_data(std::move(y), std::move(m));
   };
 
@@ -285,7 +297,7 @@ private:
 // hands the field an expression template referencing operands that die here.
 template <typename Field, typename Function, typename S>
 void build_extinction_field(Field& field, Function f_competition_all_knots,
-                            S height_max) {
+                            S height_max, double read_below = R_PosInf) {
   using value_type = typename Field::value_type;
   field.compute_environment(
     [&](const std::vector<value_type>& x, std::vector<value_type>& y,
@@ -297,7 +309,7 @@ void build_extinction_field(Field& field, Function f_competition_all_knots,
         y[k] = std::move(E);
       }
     },
-    height_max);
+    height_max, read_below);
 }
 
 } // plant namespace
