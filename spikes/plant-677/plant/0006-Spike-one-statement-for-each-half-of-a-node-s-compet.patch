diff --git a/inst/include/plant/canopy_shape.h b/inst/include/plant/canopy_shape.h
index 420ece5d..a3159b73 100644
--- a/inst/include/plant/canopy_shape.h
+++ b/inst/include/plant/canopy_shape.h
@@ -190,6 +190,24 @@ public:
     return {tmp * tmp, 2.0 * eta_ * tmp * u_eta / z};
   }
 
+  // Q_and_q's pair times (k * a) and then b, the way a node scales its crown's
+  // competition by its leaf area and density. On the deep crown each half is one
+  // expression, the same operations in the same order, so where a value and its
+  // scaling would be three statements apiece they are one.
+  std::pair<S, S> Q_and_q_times(const S& z_over_height, const S& z,
+                                const S& height_inverse, const S& k,
+                                const S& a, const S& b) const {
+    if (shading_model_ == ShadingModel::DeepCrown && !(z_over_height > 1.0) &&
+        !(z <= 0.0)) {
+      const S u_eta = pow_eta(z_over_height);
+      return {b * ((k * a) * ((1.0 - u_eta) * (1.0 - u_eta))),
+              b * (-((k * a) * (2.0 * eta_ * (1.0 - u_eta) * u_eta / z)))};
+    }
+    const S scale = k * a;
+    const std::pair<S, S> Qq = Q_and_q(z_over_height, z, height_inverse);
+    return {b * (scale * Qq.first), b * (-(scale * Qq.second))};
+  }
+
 
   // Q as a polynomial in w = (z / H)^eta -- for the smooth profile Q = 1 - 2w + w^2
   // -- and w SEPARATES: w = z^eta * H^-eta. So a reduction over crowns at many
@@ -247,6 +265,19 @@ public:
     out[2] = 2.0 * eta_ * t * t_over_z;
   }
 
+  // Both of the above from one z^eta.
+  void height_weights_and_slopes(const S& z, std::array<S, max_moments>& w,
+                                 std::array<S, max_moments>& slope) const {
+    const S t = pow_eta(z);
+    w[0] = S(1.0);
+    w[1] = -2.0 * t;
+    w[2] = t * t;
+    const S t_over_z = z > 0.0 ? S(t / z) : (eta_ == 1.0 ? S(1.0) : S(0.0));
+    slope[0] = S(0.0);
+    slope[1] = -2.0 * eta_ * t_over_z;
+    slope[2] = 2.0 * eta_ * t * t_over_z;
+  }
+
   S Q(const S& z_over_height) const {
     if (z_over_height > 1.0) {
       return S(0.0);
