+  // The same pair times a node's density, with the scalings inside the
+  // expressions rather than recorded after them.
+  with_slope<S>
+  compute_competition_and_slope(const S& z, const Internals<S>& vars,
+                                const S& density) const {
+    const S& area_leaf_ = vars.aux(COMPETITION_EFFECT_AUX_INDEX);
+    const S& height_inverse = vars.aux(HEIGHT_INVERSE_AUX_INDEX);
+    std::pair<S, S> scaled = canopy_shape.Q_and_q_times(
+        z * height_inverse, z, height_inverse, pars.k_I, area_leaf_, density);
+    return {std::move(scaled.first), std::move(scaled.second)};
+  }
+
   // [      ] Inverse of Q: height above which fraction 'x' of leaf found
   S Qp(const S& x, const S& height) const;
 
