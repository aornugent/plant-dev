From 203e69d47cdcc03ebdb3520976fa54c8ffc3266f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 02:10:03 +0000
Subject: [PATCH 1/9] Spike: fold the crown shape into per-node weights on the
 active path

The crown nodes sit at h * s_j, so q's shape factor and the interval's
half-length are a constant per node. The active integral is one spline read,
one leaf rate and one accumulate per node; the double path is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LFsPxk1yy62LrcCbtZUVeB
---
 inst/include/plant/models/ff16_strategy.h | 20 ++++++++++++++++++++
 inst/include/plant/qk.h                   |  3 +++
 src/qk.cpp                                | 14 ++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/inst/include/plant/models/ff16_strategy.h b/inst/include/plant/models/ff16_strategy.h
index c839e156..9df132ca 100644
--- a/inst/include/plant/models/ff16_strategy.h
+++ b/inst/include/plant/models/ff16_strategy.h
@@ -771,6 +771,8 @@ public:
     dmass_dheight_0 = src.dmass_dheight_0;
     area_leaf_0 = S(odelia::util::to_passive(src.area_leaf_0));
     function_integrator = src.function_integrator;
+    crown_fractions = src.crown_fractions;
+    crown_weights = src.crown_weights;
 
     // The index maps and the slot numbers are a function of the names, so they
     // are derived rather than carried.
@@ -824,6 +826,11 @@ public:
   // For integrating functions with using Gauss-Kronrod quadrature
   quadrature::QK function_integrator;
 
+  // The deep-crown rule at crown fractions s_j, with q's shape and the
+  // interval's half-length folded into each weight: the integral is then
+  // sum_j crown_weights[j] * assimilation_leaf(light(height * s_j)).
+  std::vector<double> crown_fractions, crown_weights;
+
 private:
   // Bind the competition profile and the assimilation implementation to one
   // shading model. Called by prepare_strategy() from the Control string and by
@@ -1026,6 +1033,13 @@ S FF16_Strategy<S>::assimilation_deep_crown(const FF16_Environment<S>& environme
   // capped get_environment_at_height() overload rather than re-reading
   // spline.max() at every quadrature point.
   const double canopy_top = environment.max_environment_height();
+  if constexpr (!std::is_same_v<S, double>) {
+    for (size_t j = 0; j < crown_fractions.size(); ++j) {
+      A += crown_weights[j] * assimilation_leaf(environment.get_environment_at_height(
+                                  height * crown_fractions[j], canopy_top));
+    }
+    return area_leaf * A;
+  }
   auto f = [&](const S& z) -> S {
     return assimilation_leaf(environment.get_environment_at_height(z, canopy_top)) *
       canopy_shape.q(z * height_inverse, z);
@@ -1529,6 +1543,12 @@ void FF16_Strategy<S>::prepare_strategy() {
     shading_model_from_string(this->control.shading_model, ShadingModel::DeepCrown));
 
   eta_c = CanopyShape<S>::eta_c(pars.eta);
+  // q(s, h s) * h = q(s, s), so at h = 1 the shape and the interval's
+  // half-length fold into one weight per node.
+  function_integrator.unit_rule(crown_fractions, crown_weights);
+  for (size_t j = 0; j < crown_fractions.size(); ++j) {
+    crown_weights[j] *= canopy_shape.q(crown_fractions[j], crown_fractions[j]);
+  }
   // NOTE: Also pre-computing, though less trivial
   height_0 = height_seed();
   area_leaf_0 = area_leaf(height_0);
diff --git a/inst/include/plant/qk.h b/inst/include/plant/qk.h
index 9dcb3d72..8bd6fdf9 100644
--- a/inst/include/plant/qk.h
+++ b/inst/include/plant/qk.h
@@ -35,6 +35,9 @@ public:
   // These two provide very low level access to the integration
   // routines.
   std::vector<double> integrate_vector_x(double a, double b) const;
+  // The rule on [0, 1]: its abscissae, in integrate_vector_x's order, and the
+  // weight each carries.
+  void unit_rule(std::vector<double>& x, std::vector<double>& w) const;
   double integrate_vector(const std::vector<double>& y,
                           double a, double b);
 
diff --git a/src/qk.cpp b/src/qk.cpp
index 6790070c..19f767eb 100644
--- a/src/qk.cpp
+++ b/src/qk.cpp
@@ -49,6 +49,20 @@ std::vector<double> QK::integrate_vector_x(double a, double b) const {
   return x;
 }
 
+void QK::unit_rule(std::vector<double>& x, std::vector<double>& w) const {
+  x = integrate_vector_x(0.0, 1.0);
+  w.clear();
+  w.push_back(0.5 * wgk[n - 1]);
+  for (size_t j = 0; j < (n - 1) / 2; j++) {
+    w.push_back(0.5 * wgk[j * 2 + 1]);
+    w.push_back(0.5 * wgk[j * 2 + 1]);
+  }
+  for (size_t j = 0; j < n / 2; j++) {
+    w.push_back(0.5 * wgk[j * 2]);
+    w.push_back(0.5 * wgk[j * 2]);
+  }
+}
+
 double QK::integrate_vector(const std::vector<double>& y,
                             double a, double b) {
   util::check_length(y.size(), 2 * n - 1);
