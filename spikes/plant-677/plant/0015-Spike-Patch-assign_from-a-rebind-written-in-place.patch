From 6ca991855abff618db1d0b2a6d416c820c1bd99b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 07:25:24 +0000
Subject: [PATCH] Spike: Patch::assign_from, a rebind written in place

---
 inst/include/plant/patch.h | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/inst/include/plant/patch.h b/inst/include/plant/patch.h
index acfea2b0..6e42e0a7 100644
--- a/inst/include/plant/patch.h
+++ b/inst/include/plant/patch.h
@@ -132,6 +132,11 @@ public:
   template <class U>
     requires PatchRebindable<T, E, U>
   Patch<at_scalar<T, U>, at_scalar<E, U>> rebind_from() const;
+  // rebind_from's result written into this patch, which a rebind made from the
+  // same run: nodes are dropped or added at the newest end to reach `from`'s
+  // width, then its birth records, state and environment are taken.
+  template <typename T0, typename E0>
+  void assign_from(const Patch<T0, E0>& from);
 
 
   // Every scalar's Patch is one class, so a rebind reaches the rebound patch's
@@ -804,6 +809,32 @@ Patch<at_scalar<T, U>, at_scalar<E, U>> Patch<T,E>::rebind_from() const {
   return out;
 }
 
+template <typename T, typename E>
+template <typename T0, typename E0>
+void Patch<T,E>::assign_from(const Patch<T0, E0>& from) {
+  for (size_t i = 0; i < species.size(); ++i) {
+    auto& to = species[i];
+    const auto& f = from.species[i];
+    while (to.size() > f.size()) {
+      to.remove_newest_node();
+    }
+    while (to.size() < f.size()) {
+      to.introduce_new_node();
+    }
+    to.set_birth_state(f.node_times(), f.r_patch_densities(),
+                       f.r_pr_patch_survival_at_birth());
+  }
+  std::vector<value_type> node_state(from.node_ode_size());
+  odelia::ode::ode_state(from.species.begin(), from.species.end(),
+                         node_state.begin());
+  odelia::ode::set_ode_state(species.begin(), species.end(), node_state.begin());
+  environment = from.environment.template rebind_from<value_type>();
+  environment.set_shading_model(control.shading_model,
+                                control.ppa_layer_optical_depth,
+                                control.ppa_layer_smoothing);
+  introduction_fields = from.introduction_fields;
+}
+
 template <typename T, typename E>
 void Patch<T,E>::overwrite_strategies(std::vector<strategy_type> strategies) {
   species.clear();
