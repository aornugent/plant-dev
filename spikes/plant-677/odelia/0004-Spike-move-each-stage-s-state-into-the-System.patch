diff --git a/inst/include/odelia/ode_interface.hpp b/inst/include/odelia/ode_interface.hpp
index 543931d..fe0a24e 100644
--- a/inst/include/odelia/ode_interface.hpp
+++ b/inst/include/odelia/ode_interface.hpp
@@ -521,6 +521,17 @@ void set_ode_state(T& obj, const StateType& y, double time) {
   }
 }
 
+// A state the caller is done with is moved in: at an active scalar that hands
+// each value's slot over, where a copy records a statement per entry.
+template <typename T, typename StateType>
+void set_ode_state_moving(T& obj, StateType& y, double time) {
+  if constexpr (HasOdeTime<T>) {
+    obj.set_ode_state(std::make_move_iterator(y.begin()), time);
+  } else {
+    obj.set_ode_state(std::make_move_iterator(y.begin()));
+  }
+}
+
 }
 
 // One rate evaluation: set the state, read the rates. Every stage of a step
@@ -573,6 +584,23 @@ void derivs(T& obj, const StateType& y, StateType& dydt, const double time,
   obj.ode_rates(dydt.begin());
 }
 
+// The same two evaluations with a state the caller hands over: its entries are
+// moved into the System and left holding their values with no slot.
+template <typename T, typename StateType>
+  requires(!std::is_reference_v<StateType>)
+void derivs(T& obj, StateType&& y, StateType& dydt, const double time) {
+  internal::set_ode_state_moving(obj, y, time);
+  obj.ode_rates(dydt.begin());
+}
+template <typename T, typename StateType, typename Values>
+  requires(!std::is_reference_v<StateType>)
+void derivs(T& obj, StateType&& y, StateType& dydt, const double time,
+            Values& solved) {
+  const solved_scope<T, Values> extent{obj, solved};
+  internal::set_ode_state_moving(obj, y, time);
+  obj.ode_rates(dydt.begin());
+}
+
 // R interface functions - always use std::vector<double>
 template <typename T>
 std::vector<double> r_derivs(T& obj, const std::vector<double>& y, const double time) {
